---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getServiceSupabase, isAdminAuthenticated } from '../../lib/admin-auth';
import { TRILHAS } from '../../data/pautas';
import { getEditorialRhythmMetrics } from '../../lib/editorial-schedule';

const auth = await isAdminAuthenticated(Astro.request, Astro.cookies, Astro.locals);
if (!auth.ok) {
  return Astro.redirect('/admin/login');
}

const editId = Astro.url.searchParams.get('id');
const { client } = getServiceSupabase(Astro.locals);

let initialPauta: Record<string, unknown> | null = null;
let publishedLinks: { titulo: string; slug: string; trilha_label: string; trilha?: string }[] = [];
let allScheduleRows: { status?: string; published_at?: string | null }[] = [];

if (client) {
  if (editId) {
    const { data } = await client.from('pautas').select('*').eq('id', editId).maybeSingle();
    if (data) initialPauta = data;
  }
  const nowIso = new Date().toISOString();
  const { data: pub } = await client
    .from('pautas')
    .select('titulo, slug, trilha, trilha_label')
    .eq('status', 'published')
    .lte('published_at', nowIso)
    .order('published_at', { ascending: false })
    .limit(12);
  if (pub) publishedLinks = pub;

  const { data: sched } = await client
    .from('pautas')
    .select('status, published_at')
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(60);
  if (sched) allScheduleRows = sched;
}

const rhythm = getEditorialRhythmMetrics(allScheduleRows);
---

<AdminLayout title={editId ? 'Editar Pauta' : 'Nova Pauta'} activeNav="editor">
  <!-- Floating Live Production Pill (animated OlhaPauta red dot) -->
  <div
    id="op-working-pill"
    class="fixed top-4 left-1/2 z-50 hidden -translate-x-1/2 items-center gap-3 rounded-full border border-white/15 bg-[#1D1D1F] px-5 py-2.5 text-xs font-medium text-white shadow-2xl"
    role="status"
    aria-live="polite"
  >
    <span class="inline-flex items-center font-bold tracking-tight text-white">
      olhapauta<span class="relative ml-0.5 inline-flex h-2.5 w-2.5 items-center justify-center"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#D92B2B] opacity-80"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[#D92B2B]"></span></span>
    </span>
    <span class="h-3.5 w-px bg-white/20"></span>
    <span id="op-working-text" class="max-w-[260px] truncate sm:max-w-[420px]">Produzindo pauta...</span>
    <span id="op-working-timer" class="rounded-full bg-white/10 px-2 py-0.5 font-mono text-[10px] text-white/80">00:00</span>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <a href="/admin" class="text-xs font-medium text-black/50 hover:text-black">← Voltar para pautas</a>
      <h1 id="editor-heading" class="mt-1 text-2xl font-bold tracking-tight">
        {editId ? 'Editar Pauta' : 'Nova Pauta'}<span class="text-[#D92B2B]">.</span>
      </h1>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button
        id="btn-save-draft"
        type="button"
        class="rounded-full border border-black/15 bg-white px-4 py-2 text-xs font-semibold text-[#1D1D1F] hover:bg-black/5 cursor-pointer"
      >
        Salvar rascunho
      </button>
      <button
        id="btn-schedule-prime"
        type="button"
        title="Agenda automaticamente no próximo horário nobre do Google Discover (08h00, 12h30 ou 18h30 BRT) respeitando o limite diário"
        class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold text-blue-800 hover:bg-blue-100 cursor-pointer"
      >
        ⏰ Agendar · {rhythm.nextSlotNormal.shortLabel}
      </button>
      <button
        id="btn-publish"
        type="button"
        class="rounded-full bg-[#1D1D1F] px-5 py-2 text-xs font-semibold text-white hover:opacity-90 cursor-pointer"
      >
        Publicar agora
      </button>
    </div>
  </div>

  <!-- ALWAYS-VISIBLE 1-Click Editorial Autopilot (Discover Trending + Full Generate: Text + 16:9 Cover) -->
  <section id="ai-bar" class="mt-5 rounded-3xl border border-black/10 bg-white p-6 shadow-sm space-y-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-base font-bold tracking-tight">
          Autopiloto Editorial (1 clique)<span class="text-[#D92B2B]">.</span>
        </h2>
        <p class="mt-0.5 text-xs text-black/60">
          Pesquise o que está em alta hoje na nossa linha editorial ou digite um tema para gerar <strong>pauta completa + capa 16:9</strong> de uma vez.
        </p>
      </div>

      <button
        id="btn-discover-trends"
        type="button"
        class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-full bg-[#1D1D1F] px-4 py-2.5 text-xs font-semibold text-white hover:opacity-90 cursor-pointer"
      >
        ✦ Buscar o que está em alta hoje
      </button>
    </div>

    <!-- Trending Suggestions Grid (populated on 1 click) -->
    <div id="trends-wrap" class="hidden space-y-2.5">
      <p id="trends-label" class="text-[11px] font-bold uppercase tracking-wider text-black/50"></p>
      <div id="trends-list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>

    <!-- Quick 1-Click Full Creation Bar -->
    <div class="grid gap-3 border-t border-black/10 pt-4 sm:grid-cols-12">
      <div class="sm:col-span-5">
        <input
          id="ai-topic"
          type="text"
          placeholder="Ou digite um tema livre (ex: Novo recurso de IA do WhatsApp no Brasil)"
          class="w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
        />
      </div>
      <div class="sm:col-span-3">
        <select
          id="ai-foco"
          class="w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
        >
          <option value="discover">Foco: Google Discover</option>
          <option value="search">Foco: Guia Search / AIO / GEO</option>
        </select>
      </div>
      <div class="sm:col-span-4">
        <button
          id="btn-run-ai"
          type="button"
          class="w-full rounded-xl bg-[#D92B2B] px-4 py-2.5 text-sm font-semibold text-white hover:opacity-90 cursor-pointer"
        >
          ⚡ Criar pauta completa (Texto + Capa)
        </button>
      </div>
      <div class="sm:col-span-6">
        <input
          id="ai-sources"
          type="text"
          placeholder="Links de referência opcionais (separados por vírgula)"
          class="w-full rounded-xl border border-black/10 bg-[#F5F5F7] px-3.5 py-2 text-xs focus:border-black focus:bg-white focus:outline-none"
        />
      </div>
      <div class="sm:col-span-6 flex flex-wrap items-center gap-4">
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-black/75 cursor-pointer">
          <input id="ai-web-search" type="checkbox" checked class="h-4 w-4 rounded accent-[#D92B2B]" />
          Pesquisar na web ao vivo
        </label>
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-black/75 cursor-pointer">
          <input id="ai-auto-cover" type="checkbox" checked class="h-4 w-4 rounded accent-[#D92B2B]" />
          Gerar capa 16:9 automaticamente
        </label>
      </div>
    </div>
    <p id="ai-status" class="hidden rounded-xl bg-black/[0.04] px-3.5 py-2.5 text-xs font-medium"></p>
  </section>

  <!-- Global Save Feedback -->
  <div id="save-feedback" class="mt-5 hidden rounded-2xl px-4 py-3 text-xs font-medium"></div>

  <!-- 2-Column Structured Editor + Live Google Semaphore -->
  <div class="mt-6 grid gap-6 lg:grid-cols-12 items-start">
    <!-- Left Column: Structured Content -->
    <div class="space-y-6 lg:col-span-8">
      <!-- Basics -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">1. Identidade & SEO (H1 único)</h2>

        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label class="block text-xs font-semibold text-black/70">Editoria</label>
            <select id="f-trilha" class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3 py-2 text-sm">
              {TRILHAS.map((t) => <option value={t.slug}>{t.nome}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Status</label>
            <select id="f-status" class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3 py-2 text-sm">
              <option value="draft">Rascunho</option>
              <option value="review">Revisão</option>
              <option value="published">Publicada</option>
              <option value="archived">Arquivada</option>
            </select>
          </div>
          <div class="flex items-end pb-2">
            <label class="inline-flex items-center gap-2 text-xs font-semibold text-black/75 cursor-pointer">
              <input id="f-destaque" type="checkbox" class="h-4 w-4 rounded accent-[#D92B2B]" />
              Destaque na capa
            </label>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-black/70">Título (H1 único · 50–85 chars)</label>
          <input
            id="f-titulo"
            type="text"
            placeholder="Título forte, humano e sem travessões"
            class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-base font-semibold focus:border-black focus:bg-white focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-black/70">Slug (URL em /pauta/...)</label>
          <input
            id="f-slug"
            type="text"
            placeholder="gerado-automaticamente-do-titulo"
            class="mt-1 w-full rounded-xl border border-black/10 bg-[#F5F5F7] px-3.5 py-2 text-xs font-mono focus:border-black focus:bg-white focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-black/70">Subtítulo / Meta Description (120–180 chars)</label>
          <textarea
            id="f-subtitulo"
            rows="2"
            placeholder="Linha fina explicando o impacto real da pauta"
            class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-black/70">Resumo curto (Cards da Home e llms.txt)</label>
          <textarea
            id="f-resumo"
            rows="2"
            placeholder="1 a 2 frases objetivas"
            class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
          ></textarea>
        </div>
      </section>

      <!-- Media: 16:9 Image + Optional Video -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">2. Capa 16:9 (Google Discover) & Vídeo</h2>
          <div class="flex flex-wrap items-center gap-2">
            <button
              id="btn-search-photo"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full border border-black/15 bg-white px-3.5 py-1.5 text-xs font-semibold text-[#1D1D1F] hover:bg-black/5 cursor-pointer"
            >
              🔍 Buscar foto livre (CC/DP)
            </button>
            <button
              id="btn-gen-cover"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full bg-[#D92B2B] px-3.5 py-1.5 text-xs font-semibold text-white hover:opacity-90 cursor-pointer"
            >
              ✦ Gerar capa 16:9 com IA
            </button>
            <label class="inline-flex items-center gap-2 rounded-full bg-black px-3.5 py-1.5 text-xs font-semibold text-white hover:opacity-90 cursor-pointer">
              <span>Subir foto 16:9</span>
              <input id="f-upload" type="file" accept="image/webp,image/jpeg,image/png,image/avif" class="hidden" />
            </label>
          </div>
        </div>

        <p id="upload-status" class="hidden text-xs font-medium text-black/65"></p>

        <!-- Free License Photo Picker (Wikimedia Commons CC0 / CC-BY) -->
        <div id="photo-picker-wrap" class="hidden space-y-3 rounded-2xl border border-black/10 bg-[#F5F5F7]/70 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <input
              id="photo-search-query"
              type="text"
              placeholder="Termo em inglês para refinar (opcional, ex: datacenter, smartphone, office)"
              class="flex-1 min-w-[200px] rounded-xl border border-black/15 bg-white px-3 py-1.5 text-xs focus:border-black focus:outline-none"
            />
            <button
              id="btn-search-photo-go"
              type="button"
              class="rounded-xl bg-[#1D1D1F] px-3.5 py-1.5 text-xs font-semibold text-white hover:opacity-90 cursor-pointer"
            >
              Pesquisar
            </button>
          </div>
          <div id="photo-picker-grid" class="grid gap-3 sm:grid-cols-3"></div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-black/70">URL da imagem de capa (16:9, mínimo 1200px)</label>
            <input
              id="f-imagem-url"
              type="url"
              placeholder="https://... (ou clique em Subir foto 16:9 acima)"
              class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Texto Alt acessível (SEO de imagem)</label>
            <input
              id="f-imagem-alt"
              type="text"
              placeholder="Descrição clara da cena na imagem"
              class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Crédito da imagem</label>
            <input
              id="f-imagem-credito"
              type="text"
              value="Editorial OlhaPauta"
              class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
            />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-black/70">Vídeo opcional (URL do YouTube ou MP4 — gera VideoObject JSON-LD)</label>
            <input
              id="f-video-url"
              type="url"
              placeholder="https://www.youtube.com/watch?v=... (deixe vazio se for apenas foto)"
              class="mt-1 w-full rounded-xl border border-black/10 bg-[#F5F5F7] px-3.5 py-2 text-sm focus:border-black focus:bg-white focus:outline-none"
            />
          </div>
        </div>
      </section>

      <!-- TL;DR (AIO / GEO) -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">3. O que você precisa saber (3 pontos · AIO / GEO)</h2>
        <input id="f-tldr-0" type="text" placeholder="Ponto 1: tese principal em 1 frase direta" class="w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
        <input id="f-tldr-1" type="text" placeholder="Ponto 2: dado ou mudança prática" class="w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
        <input id="f-tldr-2" type="text" placeholder="Ponto 3: impacto para o leitor" class="w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
      </section>

      <!-- Sections H2 / H3 -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">4. Corpo da Pauta (H2 + Subseções H3)</h2>
          <button
            id="btn-add-section"
            type="button"
            class="rounded-full bg-black/5 px-3.5 py-1.5 text-xs font-semibold text-black hover:bg-black/10 cursor-pointer"
          >
            + Nova seção H2
          </button>
        </div>
        <div id="sections-container" class="space-y-4"></div>
      </section>

      <!-- FAQs -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">5. Perguntas Frequentes (FAQPage JSON-LD)</h2>
          <button
            id="btn-add-faq"
            type="button"
            class="rounded-full bg-black/5 px-3.5 py-1.5 text-xs font-semibold text-black hover:bg-black/10 cursor-pointer"
          >
            + Nova pergunta
          </button>
        </div>
        <div id="faqs-container" class="space-y-3"></div>
      </section>

      <!-- Sources, Tags, Author -->
      <section class="rounded-3xl border border-black/10 bg-white p-6 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">6. Fontes (E-E-A-T), Tags & Autor</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-black/70">Tags (separadas por vírgula)</label>
            <input id="f-tags" type="text" placeholder="IA, AGENTES, PRODUTIVIDADE, MCP" class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Fontes primárias (1 URL por linha)</label>
            <textarea id="f-sources" rows="2" placeholder="https://..." class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-xs"></textarea>
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Autor</label>
            <input id="f-autor-nome" type="text" value="Jonathas Costa" class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-black/70">Cargo</label>
            <input id="f-autor-cargo" type="text" value="Fundador & Editor" class="mt-1 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2 text-sm" />
          </div>
        </div>
      </section>
    </div>

    <!-- Right Sticky Column: Live Google Semaphore + Discover Preview + Internal Links -->
    <aside class="space-y-5 lg:col-span-4 lg:sticky lg:top-20">
      <!-- Live Google Quality Gate -->
      <div class="rounded-3xl border border-black/10 bg-white p-5">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">Semáforo Google</h2>
          <span id="q-score" class="rounded-full bg-black/5 px-2.5 py-0.5 text-xs font-bold">0%</span>
        </div>
        <p id="q-stats" class="mt-1 text-xs text-black/55">0 palavras · 2 MIN de leitura</p>
        <ul id="q-checks" class="mt-4 space-y-2.5 text-xs"></ul>

        {publishedLinks.length > 0 && (
          <button
            id="btn-auto-internal-link"
            type="button"
            class="mt-4 hidden w-full rounded-full border border-[#D92B2B]/30 bg-[#D92B2B]/5 px-3.5 py-2 text-xs font-semibold text-[#D92B2B] hover:bg-[#D92B2B]/10 cursor-pointer"
          >
            ⚡ Inserir link interno automático
          </button>
        )}

        <div class="mt-4 rounded-2xl bg-[#F5F5F7] p-3 text-[11px] text-black/65">
          <p class="font-bold text-[#1D1D1F]">Toque humano (2 min):</p>
          <p class="mt-0.5 leading-relaxed">
            Revise título, 1º parágrafo e confirme a capa 16:9. Hoje: <strong id="editor-rhythm-count">{rhythm.publishedToday}/3</strong> publicadas.
          </p>
        </div>
      </div>

      <!-- Mobile Discover Card Preview -->
      <div class="rounded-3xl border border-black/10 bg-white p-5">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">Prévia no Google Discover</h2>
          <span id="prev-img-dim" class="text-[10px] font-semibold text-black/45"></span>
        </div>
        <div class="mt-3 overflow-hidden rounded-2xl border border-black/10 bg-[#F5F5F7]">
          <img
            id="prev-img"
            src="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=1200&q=80"
            alt="Prévia"
            class="aspect-[16/9] w-full object-cover"
          />
          <div class="p-3.5">
            <p class="text-[11px] font-semibold text-black/50">olhapauta.com.br</p>
            <p id="prev-title" class="mt-1 text-sm font-bold leading-snug text-[#1D1D1F]">
              Seu título de capa aparece aqui...
            </p>
          </div>
        </div>
      </div>

      <!-- Suggested Internal Links -->
      {publishedLinks.length > 0 && (
        <div class="rounded-3xl border border-black/10 bg-white p-5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">Links internos sugeridos</h2>
          <p class="mt-1 text-[11px] text-black/55">Linke pautas relacionadas para subir páginas/sessão no AdSense.</p>
          <ul class="mt-3 space-y-2">
            {publishedLinks.map((item) => (
              <li class="flex items-center justify-between gap-2 text-xs">
                <span class="truncate text-black/75" title={item.titulo}>
                  <strong class="text-[#D92B2B]">{item.trilha_label}:</strong> {item.titulo}
                </span>
                <button
                  type="button"
                  data-copy-url={`https://olhapauta.com.br/pauta/${item.slug}`}
                  class="copy-link-btn shrink-0 rounded-full border border-black/15 px-2.5 py-0.5 text-[11px] font-semibold hover:bg-black/5 cursor-pointer"
                >
                  Copiar
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <script define:vars={{ initialPauta, editId, publishedLinks, rhythm }}>
    const AI_CLICHES = [
      'no cenário atual',
      'é importante ressaltar',
      'vale ressaltar',
      'vale destacar',
      'em suma',
      'mergulhar fundo',
      'revolucionário',
      'divisor de águas',
      'neste artigo vamos',
    ];

    const escHtml = (str) =>
      String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const slugify = (text) =>
      (text || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 96);

    const $ = (id) => document.getElementById(id);

    let sectionsState = [
      { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
      { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
      { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
      { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
    ];
    let faqsState = [
      { pergunta: '', resposta: '' },
      { pergunta: '', resposta: '' },
      { pergunta: '', resposta: '' },
    ];

    let currentEditId = editId || null;
    let slugTouched = Boolean(currentEditId);
    let hasUnsavedChanges = false;
    const DEFAULT_PREVIEW_IMG = 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=1200&q=80';
    const getAutosaveKey = () => (currentEditId ? `op_admin_draft_${currentEditId}` : 'op_admin_draft_new');

    const saveLocalAutosave = () => {
      try {
        const snap = collectPayload();
        if (!snap.titulo && snap.conteudo.length === 0) return;
        localStorage.setItem(getAutosaveKey(), JSON.stringify({ savedAt: Date.now(), data: snap }));
        hasUnsavedChanges = true;
      } catch {}
    };

    const clearLocalAutosave = () => {
      try {
        localStorage.removeItem(getAutosaveKey());
        localStorage.removeItem('op_admin_draft_new');
      } catch {}
      hasUnsavedChanges = false;
    };

    window.addEventListener('beforeunload', (e) => {
      if (hasUnsavedChanges) {
        e.preventDefault();
        e.returnValue = '';
      }
    });

    const renderSections = () => {
      const container = $('sections-container');
      container.innerHTML = sectionsState
        .map(
          (sec, idx) => `
        <div class="rounded-2xl border border-black/10 bg-[#F5F5F7]/70 p-4 space-y-3" data-sec="${idx}">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-black/45">Seção H2 #${idx + 1}</span>
            <button type="button" data-remove-sec="${idx}" class="text-xs font-semibold text-red-600 hover:underline cursor-pointer">Remover</button>
          </div>
          <input type="text" data-sec-field="heading" data-idx="${idx}" value="${escHtml(sec.heading)}" placeholder="Título H2 desta seção" class="w-full rounded-xl border border-black/15 bg-white px-3 py-2 text-sm font-semibold" />
          <textarea rows="4" data-sec-field="paragraphs" data-idx="${idx}" placeholder="Parágrafos da seção (separe parágrafos com uma linha em branco)" class="w-full rounded-xl border border-black/15 bg-white px-3 py-2 text-sm">${escHtml((sec.paragraphs || []).join('\n\n'))}</textarea>

          <div class="space-y-2 pl-3 border-l-2 border-black/10">
            ${(sec.subsections || [])
              .map(
                (sub, sIdx) => `
              <div class="rounded-xl bg-white p-3 space-y-2 border border-black/10">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase text-black/45">Subseção H3</span>
                  <button type="button" data-remove-sub="${idx}:${sIdx}" class="text-[11px] text-red-600 cursor-pointer">Remover H3</button>
                </div>
                <input type="text" data-sub-field="heading" data-idx="${idx}" data-sidx="${sIdx}" value="${escHtml(sub.heading)}" placeholder="Subtítulo H3" class="w-full rounded-lg border border-black/15 px-2.5 py-1.5 text-xs font-semibold" />
                <textarea rows="2" data-sub-field="paragraphs" data-idx="${idx}" data-sidx="${sIdx}" placeholder="Texto da subseção H3" class="w-full rounded-lg border border-black/15 px-2.5 py-1.5 text-xs">${escHtml((sub.paragraphs || []).join('\n\n'))}</textarea>
              </div>
            `
              )
              .join('')}
            <button type="button" data-add-sub="${idx}" class="text-xs font-semibold text-black/65 hover:text-black cursor-pointer">+ Adicionar subseção H3</button>
          </div>

          <details class="text-xs text-black/60">
            <summary class="cursor-pointer font-semibold">Extras opcionais (citação, callout, lista)</summary>
            <div class="mt-2 space-y-2">
              <input type="text" data-sec-field="quote" data-idx="${idx}" value="${escHtml(sec.quote)}" placeholder="Citação editorial de destaque (opcional)" class="w-full rounded-lg border border-black/15 bg-white px-3 py-1.5 text-xs" />
              <input type="text" data-sec-field="calloutText" data-idx="${idx}" value="${escHtml(sec.calloutText)}" placeholder="Box de contexto / callout (opcional)" class="w-full rounded-lg border border-black/15 bg-white px-3 py-1.5 text-xs" />
              <textarea rows="2" data-sec-field="bullets" data-idx="${idx}" placeholder="Itens em lista (1 item por linha, opcional)" class="w-full rounded-lg border border-black/15 bg-white px-3 py-1.5 text-xs">${escHtml(sec.bullets)}</textarea>
            </div>
          </details>
        </div>
      `
        )
        .join('');

      container.querySelectorAll('[data-sec-field]').forEach((el) => {
        el.addEventListener('input', () => {
          const i = Number(el.dataset.idx);
          const f = el.dataset.secField;
          if (f === 'paragraphs') {
            sectionsState[i].paragraphs = el.value.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
          } else {
            sectionsState[i][f] = el.value;
          }
          updateQuality();
        });
      });

      container.querySelectorAll('[data-sub-field]').forEach((el) => {
        el.addEventListener('input', () => {
          const i = Number(el.dataset.idx);
          const si = Number(el.dataset.sidx);
          const f = el.dataset.subField;
          if (f === 'paragraphs') {
            sectionsState[i].subsections[si].paragraphs = el.value.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
          } else {
            sectionsState[i].subsections[si][f] = el.value;
          }
          updateQuality();
        });
      });

      container.querySelectorAll('[data-remove-sec]').forEach((btn) => {
        btn.addEventListener('click', () => {
          sectionsState.splice(Number(btn.dataset.removeSec), 1);
          renderSections();
          updateQuality();
        });
      });

      container.querySelectorAll('[data-add-sub]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.dataset.addSub);
          sectionsState[i].subsections = sectionsState[i].subsections || [];
          sectionsState[i].subsections.push({ heading: '', paragraphs: [''] });
          renderSections();
        });
      });

      container.querySelectorAll('[data-remove-sub]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const [i, si] = btn.dataset.removeSub.split(':').map(Number);
          sectionsState[i].subsections.splice(si, 1);
          renderSections();
          updateQuality();
        });
      });
    };

    const renderFaqs = () => {
      const container = $('faqs-container');
      container.innerHTML = faqsState
        .map(
          (faq, idx) => `
        <div class="rounded-2xl border border-black/10 bg-[#F5F5F7]/70 p-3.5 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase text-black/45">FAQ #${idx + 1}</span>
            <button type="button" data-remove-faq="${idx}" class="text-xs text-red-600 cursor-pointer">Remover</button>
          </div>
          <input type="text" data-faq-field="pergunta" data-idx="${idx}" value="${escHtml(faq.pergunta)}" placeholder="Pergunta real que o leitor busca no Google?" class="w-full rounded-xl border border-black/15 bg-white px-3 py-1.5 text-xs font-semibold" />
          <textarea rows="2" data-faq-field="resposta" data-idx="${idx}" placeholder="Resposta objetiva em 2 a 3 frases" class="w-full rounded-xl border border-black/15 bg-white px-3 py-1.5 text-xs">${escHtml(faq.resposta)}</textarea>
        </div>
      `
        )
        .join('');

      container.querySelectorAll('[data-faq-field]').forEach((el) => {
        el.addEventListener('input', () => {
          faqsState[Number(el.dataset.idx)][el.dataset.faqField] = el.value;
          updateQuality();
        });
      });

      container.querySelectorAll('[data-remove-faq]').forEach((btn) => {
        btn.addEventListener('click', () => {
          faqsState.splice(Number(btn.dataset.removeFaq), 1);
          renderFaqs();
          updateQuality();
        });
      });
    };

    const collectPayload = (statusOverride) => {
      const conteudo = sectionsState
        .map((s) => {
          const out = {
            heading: (s.heading || '').trim() || undefined,
            paragraphs: (s.paragraphs || []).filter((p) => p.trim()),
          };
          const subs = (s.subsections || [])
            .map((sub) => ({
              heading: (sub.heading || '').trim(),
              paragraphs: (sub.paragraphs || []).filter((p) => p.trim()),
            }))
            .filter((sub) => sub.heading || sub.paragraphs.length > 0);
          if (subs.length > 0) out.subsections = subs;
          if (s.quote?.trim()) out.quote = s.quote.trim();
          if (s.calloutText?.trim()) out.callout = { label: 'Contexto', text: s.calloutText.trim() };
          const bullets = (s.bullets || '').split('\n').map((b) => b.trim()).filter(Boolean);
          if (bullets.length > 0) out.bullets = bullets;
          return out;
        })
        .filter((s) => s.heading || s.paragraphs.length > 0);

      return {
        id: currentEditId || undefined,
        trilha: $('f-trilha').value,
        status: statusOverride || $('f-status').value,
        destaque: $('f-destaque').checked,
        titulo: $('f-titulo').value.trim(),
        slug: $('f-slug').value.trim() || slugify($('f-titulo').value),
        subtitulo: $('f-subtitulo').value.trim(),
        resumo_curto: $('f-resumo').value.trim(),
        imagem_url: $('f-imagem-url').value.trim(),
        imagem_alt: $('f-imagem-alt').value.trim(),
        imagem_credito: $('f-imagem-credito').value.trim() || 'Editorial OlhaPauta',
        video_url: $('f-video-url').value.trim() || null,
        tldr: [$('f-tldr-0').value.trim(), $('f-tldr-1').value.trim(), $('f-tldr-2').value.trim()].filter(Boolean),
        conteudo,
        faqs: faqsState.filter((f) => f.pergunta?.trim() && f.resposta?.trim()),
        tags: $('f-tags').value.split(',').map((t) => t.trim()).filter(Boolean),
        source_urls: $('f-sources').value.split('\n').map((u) => u.trim()).filter(Boolean),
        autor_nome: $('f-autor-nome').value.trim() || 'Jonathas Costa',
        autor_cargo: $('f-autor-cargo').value.trim() || 'Fundador & Editor',
      };
    };

    const updateQuality = () => {
      const p = collectPayload();
      const parts = [p.titulo, p.subtitulo, p.resumo_curto, ...p.tldr];
      for (const s of p.conteudo) {
        if (s.heading) parts.push(s.heading);
        parts.push(...s.paragraphs);
        if (s.quote) parts.push(s.quote);
        if (s.callout?.text) parts.push(s.callout.text);
        if (s.bullets) parts.push(...s.bullets);
        for (const sub of s.subsections || []) {
          parts.push(sub.heading, ...sub.paragraphs);
        }
      }
      for (const f of p.faqs) parts.push(f.pergunta, f.resposta);

      const fullText = parts.filter(Boolean).join(' ');
      const words = fullText ? fullText.split(/\s+/).filter(Boolean).length : 0;
      const readMin = Math.max(2, Math.ceil(words / 220));
      const h2Count = p.conteudo.filter((s) => s.heading).length;
      const hasDashes = /[—–]/.test(fullText);
      const foundCliches = AI_CLICHES.filter((c) => fullText.toLowerCase().includes(c));

      const hasInternalLink = /\/pauta\/[a-z0-9-]+/i.test(fullText);
      const otherPublished = (publishedLinks || []).filter((item) => item.slug !== p.slug);

      const checks = [
        { ok: !hasDashes ? 'pass' : 'fail', label: 'Zero travessões (— / –)', detail: hasDashes ? 'Remova travessões!' : 'OK' },
        { ok: foundCliches.length === 0 ? 'pass' : 'warn', label: 'Sem clichês de IA', detail: foundCliches.length ? foundCliches.join(', ') : 'OK' },
        { ok: p.titulo.length >= 40 && p.titulo.length <= 105 ? 'pass' : p.titulo.length >= 15 ? 'warn' : 'fail', label: 'Título H1 (40–105 chars)', detail: `${p.titulo.length} chars` },
        { ok: p.imagem_url && p.imagem_alt.length >= 15 ? 'pass' : p.imagem_url ? 'warn' : 'fail', label: 'Capa 16:9 + Alt', detail: p.imagem_url ? 'OK' : 'Faltando' },
        { ok: words >= 750 && h2Count >= 4 ? 'pass' : words >= 400 ? 'warn' : 'fail', label: 'Profundidade (800+ pal. · 4+ H2)', detail: `${words} pal. · ${h2Count} H2` },
        { ok: p.tldr.length >= 3 ? 'pass' : 'warn', label: 'O que você precisa saber (3)', detail: `${p.tldr.length}/3` },
        { ok: p.faqs.length >= 3 ? 'pass' : 'warn', label: 'FAQs (FAQPage JSON-LD)', detail: `${p.faqs.length} FAQs` },
      ];

      if (otherPublished.length > 0) {
        checks.push({
          ok: hasInternalLink ? 'pass' : 'warn',
          label: 'Link interno (outra pauta)',
          detail: hasInternalLink ? 'OK' : 'Recomendado p/ SEO e AdSense',
        });
      }

      const autoLinkBtn = $('btn-auto-internal-link');
      if (autoLinkBtn) {
        autoLinkBtn.classList.toggle('hidden', otherPublished.length === 0 || hasInternalLink);
      }

      const passed = checks.filter((c) => c.ok === 'pass').length;
      const warned = checks.filter((c) => c.ok === 'warn').length;
      const score = Math.round(((passed + warned * 0.5) / checks.length) * 100);

      $('q-score').textContent = `${score}%`;
      $('q-score').className = `rounded-full px-2.5 py-0.5 text-xs font-bold ${
        score >= 85 ? 'bg-emerald-100 text-emerald-800' : score >= 60 ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-700'
      }`;
      $('q-stats').textContent = `${words} palavras · ${readMin} MIN de leitura`;

      $('q-checks').innerHTML = checks
        .map((c) => {
          const dot = c.ok === 'pass' ? 'bg-emerald-500' : c.ok === 'warn' ? 'bg-amber-400' : 'bg-red-500';
          return `<li class="flex items-start gap-2">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full ${dot}"></span>
            <div class="min-w-0">
              <p class="font-semibold text-[#1D1D1F]">${c.label}</p>
              <p class="text-[11px] text-black/55">${c.detail}</p>
            </div>
          </li>`;
        })
        .join('');

      $('prev-title').textContent = p.titulo || 'Seu título de capa aparece aqui...';
      if (p.imagem_url) $('prev-img').src = p.imagem_url;
      saveLocalAutosave();
    };

    const hydrateForm = (data) => {
      if (!data) return;
      if (data.trilha) $('f-trilha').value = data.trilha;
      if (data.status) $('f-status').value = data.status;
      if (typeof data.destaque === 'boolean') $('f-destaque').checked = data.destaque;
      if (data.titulo) $('f-titulo').value = data.titulo;
      if (data.slug) $('f-slug').value = data.slug;
      else if (data.titulo) $('f-slug').value = slugify(data.titulo);
      if (data.subtitulo) $('f-subtitulo').value = data.subtitulo;
      if (data.resumo_curto) $('f-resumo').value = data.resumo_curto;
      if (data.imagem_url) $('f-imagem-url').value = data.imagem_url;
      if (data.imagem_alt) $('f-imagem-alt').value = data.imagem_alt;
      if (data.imagem_credito) $('f-imagem-credito').value = data.imagem_credito;
      if (data.video_url) $('f-video-url').value = data.video_url;
      if (Array.isArray(data.tldr)) {
        $('f-tldr-0').value = data.tldr[0] || '';
        $('f-tldr-1').value = data.tldr[1] || '';
        $('f-tldr-2').value = data.tldr[2] || '';
      }
      if (Array.isArray(data.conteudo) && data.conteudo.length > 0) {
        sectionsState = data.conteudo.map((s) => ({
          heading: s.heading || '',
          paragraphs: Array.isArray(s.paragraphs) ? s.paragraphs : [],
          subsections: Array.isArray(s.subsections) ? s.subsections : [],
          quote: s.quote || '',
          calloutText: s.callout?.text || '',
          bullets: Array.isArray(s.bullets) ? s.bullets.join('\n') : '',
        }));
      }
      if (Array.isArray(data.faqs) && data.faqs.length > 0) {
        faqsState = data.faqs;
      }
      if (Array.isArray(data.tags)) $('f-tags').value = data.tags.join(', ');
      if (Array.isArray(data.source_urls)) $('f-sources').value = data.source_urls.join('\n');
      if (data.autor_nome) $('f-autor-nome').value = data.autor_nome;
      if (data.autor_cargo) $('f-autor-cargo').value = data.autor_cargo;
      renderSections();
      renderFaqs();
      updateQuality();
    };

    const resetEditorForm = () => {
      clearLocalAutosave();
      currentEditId = null;
      slugTouched = false;
      $('f-trilha').value = 'ia';
      $('f-status').value = 'draft';
      $('f-destaque').checked = false;
      $('f-titulo').value = '';
      $('f-slug').value = '';
      $('f-subtitulo').value = '';
      $('f-resumo').value = '';
      $('f-imagem-url').value = '';
      $('f-imagem-alt').value = '';
      $('f-imagem-credito').value = '';
      $('f-video-url').value = '';
      $('f-tldr-0').value = '';
      $('f-tldr-1').value = '';
      $('f-tldr-2').value = '';
      $('f-tags').value = '';
      $('f-sources').value = '';
      $('f-autor-nome').value = 'Jonathas Costa';
      $('f-autor-cargo').value = 'Fundador & Editor';
      if ($('ai-topic')) $('ai-topic').value = '';
      if ($('ai-sources')) $('ai-sources').value = '';
      if ($('ai-feedback')) $('ai-feedback').className = 'hidden';
      if ($('prev-img')) $('prev-img').src = DEFAULT_PREVIEW_IMG;
      if ($('prev-img-dim')) $('prev-img-dim').textContent = '';
      if ($('editor-heading')) $('editor-heading').innerHTML = 'Nova Pauta<span class="text-[#D92B2B]">.</span>';
      sectionsState = [
        { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
        { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
        { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
        { heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' },
      ];
      faqsState = [
        { pergunta: '', resposta: '' },
        { pergunta: '', resposta: '' },
        { pergunta: '', resposta: '' },
      ];
      renderSections();
      renderFaqs();
      updateQuality();
      clearLocalAutosave();
      window.history.replaceState({}, '', '/admin/editor');
    };

    $('f-titulo').addEventListener('input', () => {
      if (!slugTouched) $('f-slug').value = slugify($('f-titulo').value);
      updateQuality();
    });
    $('f-slug').addEventListener('input', () => { slugTouched = true; });
    ['f-subtitulo', 'f-resumo', 'f-imagem-url', 'f-imagem-alt', 'f-tldr-0', 'f-tldr-1', 'f-tldr-2', 'f-tags'].forEach((id) => {
      $(id).addEventListener('input', updateQuality);
    });

    $('btn-add-section').addEventListener('click', () => {
      sectionsState.push({ heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' });
      renderSections();
      updateQuality();
    });

    $('btn-add-faq').addEventListener('click', () => {
      faqsState.push({ pergunta: '', resposta: '' });
      renderFaqs();
      updateQuality();
    });

    // Direct 16:9 image upload to Supabase Storage
    $('f-upload').addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const st = $('upload-status');
      st.textContent = 'Subindo imagem para o Supabase Storage...';
      st.classList.remove('hidden');

      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok && data.ok) {
        $('f-imagem-url').value = data.url;
        st.textContent = 'Imagem enviada com sucesso!';
        updateQuality();
      } else {
        st.textContent = `Erro no upload: ${data.error || 'falha'}`;
      }
    });

    // Free commercial-license photo search (Wikimedia Commons CC0 / CC-BY -> imports to Supabase Storage)
    const runPhotoSearch = async (customQuery = '') => {
      const wrap = $('photo-picker-wrap');
      const grid = $('photo-picker-grid');
      const st = $('upload-status');
      wrap.classList.remove('hidden');
      st.textContent = 'Buscando fotos reais livres de direitos autorais (CC0 / CC-BY, alta resolução)...';
      st.classList.remove('hidden');
      grid.innerHTML = '<p class="text-xs text-black/55 col-span-3">Pesquisando...</p>';

      try {
        const res = await fetch('/api/admin/search-images', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            titulo: $('f-titulo').value.trim(),
            trilha: $('f-trilha').value,
            query: customQuery,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Falha na busca.');
        if (!data.results || data.results.length === 0) {
          grid.innerHTML = '<p class="text-xs text-black/60 col-span-3">Nenhuma foto encontrada com esse termo. Tente outro termo em inglês acima.</p>';
          st.textContent = `Busca "${data.query}" sem resultados. Tente refinar o termo.`;
          return;
        }
        $('photo-search-query').value = data.query || '';
        st.textContent = `${data.results.length} fotos livres encontradas ("${data.query}"). Clique em uma para salvar no seu Storage com Alt e Crédito automáticos:`;

        grid.innerHTML = data.results
          .map(
            (img, idx) => `
          <button
            type="button"
            data-pick-photo="${idx}"
            class="group overflow-hidden rounded-xl border border-black/10 bg-white text-left hover:border-black transition-colors cursor-pointer"
          >
            <div class="aspect-[16/9] w-full overflow-hidden bg-black/5">
              <img src="${escHtml(img.thumbUrl || img.url)}" alt="${escHtml(String(img.title || 'Foto livre').slice(0, 60))}" referrerpolicy="no-referrer" loading="lazy" class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform" />
            </div>
            <div class="p-2">
              <p class="truncate text-[10px] font-semibold text-[#1D1D1F]">${escHtml(img.license)} · ${Number(img.width)}×${Number(img.height)}</p>
              <p class="truncate text-[10px] text-black/50">${escHtml(img.credit)}</p>
            </div>
          </button>
        `
          )
          .join('');

        grid.querySelectorAll('[data-pick-photo]').forEach((card) => {
          card.addEventListener('click', async () => {
            const chosen = data.results[Number(card.dataset.pickPhoto)];
            st.textContent = 'Salvando foto selecionada no seu Supabase Storage...';
            const impRes = await fetch('/api/admin/search-images', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ importUrl: chosen.url, titulo: $('f-titulo').value.trim() }),
            });
            const impData = await impRes.json();
            $('f-imagem-url').value = impRes.ok && impData.ok ? impData.url : chosen.url;
            if (!$('f-imagem-alt').value.trim()) $('f-imagem-alt').value = chosen.suggestedAlt;
            $('f-imagem-credito').value = chosen.credit;
            wrap.classList.add('hidden');
            st.textContent = `Foto livre aplicada com Alt e Crédito (${chosen.license})!`;
            updateQuality();
          });
        });
      } catch (err) {
        st.textContent = `Erro ao buscar fotos: ${err.message}`;
      }
    };

    $('btn-search-photo').addEventListener('click', () => runPhotoSearch($('photo-search-query').value.trim()));
    $('btn-search-photo-go').addEventListener('click', () => runPhotoSearch($('photo-search-query').value.trim()));

    // 1-Click AI 16:9 Cover Generator -> Supabase Storage
    $('btn-gen-cover').addEventListener('click', async () => {
      const titulo = $('f-titulo').value.trim();
      const prompt = $('f-imagem-alt').value.trim();
      const st = $('upload-status');
      if (!titulo && !prompt) {
        st.textContent = 'Preencha o título da pauta (ou gere o rascunho) antes de gerar a capa 16:9.';
        st.classList.remove('hidden');
        return;
      }
      const btn = $('btn-gen-cover');
      btn.disabled = true;
      btn.textContent = 'Gerando capa...';
      st.textContent = 'Gerando imagem editorial 16:9 e salvando no Supabase Storage...';
      st.classList.remove('hidden');
      showWorkingPill('Gerando capa 16:9 com IA...');

      try {
        const res = await fetch('/api/admin/generate-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            titulo,
            trilha: $('f-trilha').value,
            prompt,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Falha ao gerar capa.');
        $('f-imagem-url').value = data.url;
        if (!$('f-imagem-alt').value.trim()) $('f-imagem-alt').value = titulo;
        $('f-imagem-credito').value = 'Ilustração Editorial OlhaPauta';
        st.textContent = `Capa 16:9 gerada e salva no Storage (${data.providerUsed})!`;
        updateQuality();
      } catch (err) {
        st.textContent = `Erro ao gerar capa: ${err.message || 'verifique sua chave em Minha IA (API)'}`;
      } finally {
        hideWorkingPill();
        btn.disabled = false;
        btn.textContent = '✦ Gerar capa 16:9 com IA';
      }
    });

    let workingTimerInterval = null;
    let workingStartMs = 0;

    const showWorkingPill = (message) => {
      const pill = $('op-working-pill');
      const txt = $('op-working-text');
      const timerEl = $('op-working-timer');
      if (!pill || !txt) return;
      txt.textContent = message;
      pill.classList.remove('hidden');
      pill.classList.add('flex');
      if (!workingTimerInterval) {
        workingStartMs = Date.now();
        if (timerEl) timerEl.textContent = '00:00';
        workingTimerInterval = setInterval(() => {
          const sec = Math.floor((Date.now() - workingStartMs) / 1000);
          const mm = String(Math.floor(sec / 60)).padStart(2, '0');
          const ss = String(sec % 60).padStart(2, '0');
          if (timerEl) timerEl.textContent = `${mm}:${ss}`;
        }, 1000);
      }
    };

    const hideWorkingPill = () => {
      const pill = $('op-working-pill');
      if (pill) {
        pill.classList.add('hidden');
        pill.classList.remove('flex');
      }
      if (workingTimerInterval) {
        clearInterval(workingTimerInterval);
        workingTimerInterval = null;
      }
    };

    const runFullGeneration = async ({ topic, trilha, foco, sourceUrls, triggerBtn = null }) => {
      const st = $('ai-status');
      const btn = $('btn-run-ai');
      const allTrendBtns = Array.from(document.querySelectorAll('[data-pick-trend]'));
      allTrendBtns.forEach((b) => { b.disabled = true; });
      if (triggerBtn) {
        triggerBtn.textContent = '● Produzindo pauta...';
      }
      btn.disabled = true;
      btn.textContent = '1/2 Pesquisando e escrevendo...';
      st.textContent = 'Passo 1/2: pesquisando fatos atualizados na web e montando a pauta completa (H1, H2, H3, TL;DR e FAQs)...';
      st.className = 'rounded-xl bg-black/[0.04] px-3.5 py-2.5 text-xs font-medium text-black/75';
      showWorkingPill('Passo 1/2: pesquisando na web e escrevendo a pauta...');

      try {
        const res = await fetch('/api/admin/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            topic,
            trilha,
            foco,
            use_web_search: $('ai-web-search').checked,
            source_urls: sourceUrls,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Erro ao gerar texto.');
        slugTouched = false;
        hydrateForm(data.draft);

        const searchLabel =
          data.webSearchUsed && data.webSearchUsed !== 'none'
            ? ` · busca: ${data.webSearchUsed}`
            : '';

        if ($('ai-auto-cover').checked) {
          btn.textContent = '2/2 Gerando capa 16:9...';
          st.textContent = `Passo 2/2: texto pronto${searchLabel}! Gerando capa original 16:9 e salvando no Supabase Storage...`;
          showWorkingPill('Passo 2/2: texto pronto! Gerando capa 16:9...');
          try {
            const imgRes = await fetch('/api/admin/generate-image', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                titulo: $('f-titulo').value.trim(),
                trilha: $('f-trilha').value,
                prompt: $('f-imagem-alt').value.trim(),
              }),
            });
            const imgData = await imgRes.json();
            if (imgRes.ok && imgData.ok) {
              $('f-imagem-url').value = imgData.url;
              $('f-imagem-credito').value = 'Ilustração Editorial OlhaPauta';
              updateQuality();
              st.textContent = `Tudo pronto (${imgData.providerUsed}${searchLabel})! Confira o Semáforo Google à direita e clique em "Publicar agora" ou "Agendar".`;
              st.className = 'rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-xs font-semibold text-emerald-800';
            } else {
              st.textContent = `Texto pronto${searchLabel}, mas a capa falhou (${imgData.error || 'erro'}). Você pode subir uma foto ou ajustar o provedor de imagem em Minha IA.`;
              st.className = 'rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-xs font-semibold text-amber-900';
            }
          } catch (imgErr) {
            st.textContent = `Texto pronto${searchLabel}, mas a capa falhou (${imgErr.message}). Você pode clicar em "Gerar capa 16:9" ou subir uma foto.`;
            st.className = 'rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-xs font-semibold text-amber-900';
          }
        } else {
          st.textContent = `Rascunho pronto${searchLabel}! Adicione a capa 16:9 e clique em "Publicar agora" ou "Agendar".`;
          st.className = 'rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2.5 text-xs font-semibold text-emerald-800';
        }
      } catch (err) {
        st.textContent = err.message || 'Erro inesperado.';
        st.className = 'rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-800';
      } finally {
        hideWorkingPill();
        btn.disabled = false;
        btn.textContent = '⚡ Criar pauta completa (Texto + Capa)';
        allTrendBtns.forEach((b) => {
          b.disabled = false;
          b.textContent = '⚡ Criar esta pauta (1 clique)';
        });
      }
    };

    const TRENDS_CACHE_KEY = 'op_admin_trends_cache_v1';
    const getTodayBrtKey = () => {
      const shifted = new Date(Date.now() - 3 * 60 * 60 * 1000);
      return shifted.toISOString().slice(0, 10);
    };

    const loadTrendsCache = () => {
      try {
        const raw = localStorage.getItem(TRENDS_CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed?.dateKey === getTodayBrtKey() && Array.isArray(parsed.items) && parsed.items.length > 0) {
          return parsed;
        }
      } catch {}
      return null;
    };

    const saveTrendsCache = (cache) => {
      try {
        localStorage.setItem(TRENDS_CACHE_KEY, JSON.stringify(cache));
      } catch {}
    };

    const renderTrendsList = (cache) => {
      if (!cache || !Array.isArray(cache.items) || cache.items.length === 0) return;
      const wrap = $('trends-wrap');
      const list = $('trends-list');
      const usedSet = new Set(Array.isArray(cache.usedIndexes) ? cache.usedIndexes : []);

      $('trends-label').textContent = `${cache.items.length} pautas em alta hoje (${cache.webSearchUsed || 'cache'}) — salvas no seu navegador para não gastar busca de novo:`;
      list.innerHTML = cache.items
        .map((item, idx) => {
          const isUsed = usedSet.has(idx);
          return `
          <div class="flex flex-col justify-between rounded-2xl border ${isUsed ? 'border-emerald-200 bg-emerald-50/40' : 'border-black/10 bg-[#F5F5F7]/70'} p-4 space-y-2.5">
            <div>
              <div class="flex items-center justify-between gap-2 text-[10px] font-bold uppercase tracking-wider">
                <div class="flex items-center gap-2">
                  <span class="text-[#D92B2B]">${escHtml(item.trilha)}</span>
                  <span class="rounded-full bg-black/5 px-2 py-0.5 text-black/60">${item.foco === 'search' ? 'Search / AIO' : 'Discover'}</span>
                </div>
                ${isUsed ? '<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-emerald-800">✓ Já gerada</span>' : ''}
              </div>
              <p class="mt-1.5 text-xs font-bold leading-snug text-[#1D1D1F]">${escHtml(item.titulo)}</p>
              <p class="mt-1 text-[11px] leading-relaxed text-black/65">${escHtml(item.angulo)}</p>
              <p class="mt-1 text-[10px] text-black/45">${escHtml(item.motivo)}</p>
            </div>
            <button
              type="button"
              data-pick-trend="${idx}"
              class="w-full rounded-xl ${isUsed ? 'border border-black/15 bg-white text-[#1D1D1F] hover:bg-black/5' : 'bg-[#1D1D1F] text-white hover:opacity-90'} px-3 py-2 text-xs font-semibold cursor-pointer"
            >
              ${isUsed ? '↻ Gerar novamente' : '⚡ Criar esta pauta (1 clique)'}
            </button>
          </div>
        `;
        })
        .join('');
      wrap.classList.remove('hidden');

      list.querySelectorAll('[data-pick-trend]').forEach((pickBtn) => {
        pickBtn.addEventListener('click', () => {
          const idx = Number(pickBtn.dataset.pickTrend);
          const chosen = cache.items[idx];
          if (!chosen) return;
          const nextUsed = Array.from(new Set([...(cache.usedIndexes || []), idx]));
          const updatedCache = { ...cache, usedIndexes: nextUsed };
          saveTrendsCache(updatedCache);

          $('f-trilha').value = chosen.trilha;
          $('ai-foco').value = chosen.foco;
          $('ai-topic').value = `${chosen.titulo}. ${chosen.angulo}`;
          if (chosen.source_urls?.length) $('ai-sources').value = chosen.source_urls.join(', ');
          runFullGeneration({
            topic: `${chosen.titulo}. ${chosen.angulo}`,
            trilha: chosen.trilha,
            foco: chosen.foco,
            sourceUrls: chosen.source_urls || [],
            triggerBtn: pickBtn,
          }).then(() => {
            renderTrendsList(updatedCache);
          });
        });
      });
    };

    // Restaura automaticamente as pautas pesquisadas hoje (evita gastar Tavily/IA de novo após publicar ou recarregar)
    const cachedTrendsToday = loadTrendsCache();
    if (cachedTrendsToday) {
      renderTrendsList(cachedTrendsToday);
    }

    // 1-Click Discover Trending Topics Today
    $('btn-discover-trends').addEventListener('click', async () => {
      const btn = $('btn-discover-trends');
      const st = $('ai-status');
      btn.disabled = true;
      btn.textContent = 'Pesquisando tendências de hoje...';
      st.textContent = 'Buscando o que está em alta hoje em IA, Tecnologia, Segurança e Negócios na linha editorial do OlhaPauta...';
      st.className = 'rounded-xl bg-black/[0.04] px-3.5 py-2.5 text-xs font-medium text-black/75';
      showWorkingPill('Pesquisando o que está em alta hoje...');

      try {
        const res = await fetch('/api/admin/discover', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trilha: 'all' }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Erro ao buscar tendências.');
        const items = data.suggestions || [];
        if (items.length === 0) throw new Error('Nenhuma sugestão retornada. Tente novamente.');

        const freshCache = {
          dateKey: getTodayBrtKey(),
          webSearchUsed: data.webSearchUsed || 'tavily',
          items,
          usedIndexes: [],
        };
        saveTrendsCache(freshCache);
        renderTrendsList(freshCache);
        st.classList.add('hidden');
      } catch (err) {
        st.textContent = err.message || 'Erro ao pesquisar tendências.';
        st.className = 'rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-800';
      } finally {
        hideWorkingPill();
        btn.disabled = false;
        btn.textContent = '✦ Buscar o que está em alta hoje';
      }
    });

    // 1-Click BYOK AI generation (from free topic input)
    $('btn-run-ai').addEventListener('click', async () => {
      const topic = $('ai-topic').value.trim();
      const st = $('ai-status');
      if (topic.length < 5) {
        st.textContent = 'Digite um tema ou clique em "✦ Buscar o que está em alta hoje" acima!';
        st.className = 'rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-semibold text-red-800';
        return;
      }
      runFullGeneration({
        topic,
        trilha: $('f-trilha').value,
        foco: $('ai-foco').value,
        sourceUrls: $('ai-sources').value.split(',').map((u) => u.trim()).filter(Boolean),
      });
    });

    const isCautionMode = () => {
      try {
        return localStorage.getItem('op_admin_caution_mode') === '1';
      } catch {
        return false;
      }
    };

    const getActivePrimeSlot = () => (isCautionMode() ? rhythm.nextSlotCaution : rhythm.nextSlotNormal);
    const getDailyLimit = () => (isCautionMode() ? 2 : 3);

    const refreshScheduleButtonUi = () => {
      const slot = getActivePrimeSlot();
      const limit = getDailyLimit();
      const btn = $('btn-schedule-prime');
      if (btn && slot) {
        btn.textContent = `⏰ Agendar · ${slot.shortLabel}`;
      }
      const countEl = $('editor-rhythm-count');
      if (countEl) {
        countEl.textContent = `${rhythm.publishedToday}/${limit}`;
      }
    };
    refreshScheduleButtonUi();

    const savePauta = async (statusOverride, force = false, scheduledAt = null) => {
      const fb = $('save-feedback');
      fb.className = 'mt-5 rounded-2xl bg-black/5 px-4 py-3 text-xs font-medium text-black/75';
      fb.textContent = scheduledAt
        ? 'Agendando pauta no horário nobre do Discover...'
        : statusOverride === 'published'
          ? 'Publicando e notificando IndexNow...'
          : 'Salvando...';

      const payload = {
        ...collectPayload(statusOverride),
        force,
        scheduled_at: scheduledAt || undefined,
      };
      const res = await fetch('/api/admin/pautas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (res.status === 422 && data.blockers) {
        const msg = data.blockers.join(' | ');
        if (confirm(`Quality Gate encontrou pendências:\n\n- ${data.blockers.join('\n- ')}\n\nDeseja continuar mesmo assim?`)) {
          return savePauta(statusOverride, true, scheduledAt);
        }
        fb.className = 'mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-xs font-medium text-red-800';
        fb.textContent = `Bloqueado pelo Quality Gate: ${msg}`;
        return;
      }

      if (!res.ok || !data.ok) {
        fb.className = 'mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-xs font-medium text-red-800';
        fb.textContent = data.error || 'Erro ao salvar pauta.';
        return;
      }

      clearLocalAutosave();
      if (statusOverride === 'published') {
        const publishedUrl = escHtml(data.url || '');
        const publishedId = encodeURIComponent(data.pauta?.id || '');
        const activeSlot = getActivePrimeSlot();
        if (data.rhythm) {
          Object.assign(rhythm, data.rhythm);
          refreshScheduleButtonUi();
        }
        resetEditorForm();
        if (data.scheduled) {
          fb.className = 'mt-5 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 text-xs font-semibold text-blue-900';
          fb.innerHTML = `Pauta agendada para <strong>${escHtml(activeSlot?.label || 'o próximo horário nobre')}</strong>! Ela entra no ar automaticamente.${publishedId ? ` · <a href="/admin/editor?id=${publishedId}" class="underline">Editar esta pauta</a>` : ''}`;
        } else {
          fb.className = 'mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800';
          fb.innerHTML = `Pauta publicada e editor limpo para a próxima! <a href="${publishedUrl}" target="_blank" rel="noopener noreferrer" class="underline ml-1">Abrir no ar ↗</a>${publishedId ? ` · <a href="/admin/editor?id=${publishedId}" class="underline">Editar esta pauta</a>` : ''} ${data.indexNowSent ? '· IndexNow enviado' : ''}`;
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        fb.className = 'mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800';
        fb.textContent = 'Rascunho salvo no Supabase!';
        if (!currentEditId && data.pauta?.id) {
          currentEditId = data.pauta.id;
          window.history.replaceState({}, '', `/admin/editor?id=${encodeURIComponent(data.pauta.id)}`);
        }
      }
    };

    $('btn-save-draft').addEventListener('click', () => savePauta('draft'));
    $('btn-schedule-prime')?.addEventListener('click', () => {
      const slot = getActivePrimeSlot();
      savePauta('published', false, slot?.iso || null);
    });
    $('btn-publish').addEventListener('click', () => {
      const limit = getDailyLimit();
      if (!currentEditId && rhythm.publishedToday >= limit) {
        const slot = getActivePrimeSlot();
        if (
          confirm(
            `Você já publicou ${rhythm.publishedToday} pauta(s) hoje (meta: ${limit}/dia para consistência no Google).\n\nClique em OK para agendar automaticamente em ${slot?.label || 'próximo horário nobre'}, ou Cancelar para publicar agora mesmo.`
          )
        ) {
          return savePauta('published', false, slot?.iso || null);
        }
      }
      savePauta('published');
    });

    $('btn-auto-internal-link')?.addEventListener('click', () => {
      const currentSlug = $('f-slug').value.trim();
      const currentTrilha = $('f-trilha').value;
      const candidates = (publishedLinks || []).filter((item) => item.slug !== currentSlug);
      if (candidates.length === 0) return;
      const pick = candidates.find((item) => item.trilha === currentTrilha) || candidates[0];
      const targetIdx = sectionsState.length >= 2 ? 1 : 0;
      if (!sectionsState[targetIdx]) {
        sectionsState.push({ heading: '', paragraphs: [''], subsections: [], quote: '', calloutText: '', bullets: '' });
      }
      const sentence = `Leia também: [${pick.titulo}](/pauta/${pick.slug}).`;
      const existingParagraphs = sectionsState[targetIdx].paragraphs.filter((x) => x.trim());
      sectionsState[targetIdx].paragraphs = [...existingParagraphs, sentence];
      renderSections();
      updateQuality();
    });

    document.querySelectorAll('.copy-link-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copyUrl);
        btn.textContent = 'Copiado!';
        setTimeout(() => (btn.textContent = 'Copiar'), 1500);
      });
    });

    $('prev-img').addEventListener('load', () => {
      const img = $('prev-img');
      const w = img.naturalWidth;
      const h = img.naturalHeight;
      const badge = $('prev-img-dim');
      if (!badge || !w || !h) return;
      const okDiscover = w >= 1200 && w > h;
      badge.textContent = `${w}×${h}px ${okDiscover ? '· Discover OK' : '· Ideal >= 1200px 16:9'}`;
      badge.className = `text-[10px] font-semibold ${okDiscover ? 'text-emerald-700' : 'text-amber-700'}`;
    });

    const tryRestoreLocalAutosave = () => {
      try {
        const rawLocal = localStorage.getItem(getAutosaveKey());
        if (!rawLocal) return false;
        const parsed = JSON.parse(rawLocal);
        if (parsed?.data?.titulo || parsed?.data?.conteudo?.length) {
          hydrateForm(parsed.data);
          const fb = $('save-feedback');
          fb.className = 'mt-5 flex items-center justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs font-medium text-amber-900';
          fb.innerHTML = '<span>Rascunho local restaurado automaticamente! Você não perdeu nada.</span><button id="btn-discard-local" type="button" class="rounded-full border border-amber-400 px-3 py-1 text-[11px] font-semibold hover:bg-amber-100 cursor-pointer">Descartar rascunho local</button>';
          document.getElementById('btn-discard-local')?.addEventListener('click', () => {
            clearLocalAutosave();
            window.location.reload();
          });
          return true;
        }
      } catch {}
      return false;
    };

    if (!tryRestoreLocalAutosave()) {
      if (initialPauta) {
        hydrateForm(initialPauta);
        clearLocalAutosave();
      } else {
        renderSections();
        renderFaqs();
        updateQuality();
        hasUnsavedChanges = false;
      }
    }
  </script>
</AdminLayout>
