---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getServiceSupabase, isAdminAuthenticated } from '../../lib/admin-auth';

const auth = await isAdminAuthenticated(Astro.request, Astro.cookies, Astro.locals);
if (!auth.ok) {
  return Astro.redirect('/admin/login');
}

const mask = (k?: string | null) =>
  !k ? '' : k.length > 10 ? `${k.slice(0, 6)}••••••${k.slice(-4)}` : '••••••••';

const { client } = getServiceSupabase(Astro.locals);
let current = {
  ai_provider: 'gemini',
  ai_model: 'gemini-3.8-flash',
  ai_base_url: '',
  has_api_key: false,
  masked_api_key: '',
  has_search_key: false,
  masked_search_key: '',
  image_provider: 'cloudflare',
  image_model: '@cf/black-forest-labs/flux-1-schnell',
  has_image_key: false,
  masked_image_key: '',
};

let maskedProviderKeys: Record<string, string> = {};

if (client) {
  const { data } = await client.from('admin_settings').select('*').eq('id', 'default').maybeSingle();
  if (data) {
    const vault = (data.provider_keys as Record<string, string> | null) || {};
    if (data.ai_provider && data.ai_api_key && !vault[data.ai_provider]) {
      vault[data.ai_provider] = data.ai_api_key;
    }
    maskedProviderKeys = Object.fromEntries(
      Object.entries(vault).filter(([, v]) => Boolean(v)).map(([k, v]) => [k, mask(v)])
    );
    current = {
      ai_provider: data.ai_provider || 'gemini',
      ai_model: data.ai_model || 'gemini-3.8-flash',
      ai_base_url: data.ai_base_url || '',
      has_api_key: Boolean(vault[data.ai_provider || 'gemini'] || data.ai_api_key),
      masked_api_key: mask(vault[data.ai_provider || 'gemini'] || data.ai_api_key),
      has_search_key: Boolean(data.search_api_key),
      masked_search_key: mask(data.search_api_key),
      image_provider: data.image_provider || 'cloudflare',
      image_model: data.image_model || '@cf/black-forest-labs/flux-1-schnell',
      has_image_key: Boolean(data.image_api_key),
      masked_image_key: mask(data.image_api_key),
    };
  }
}
---

<AdminLayout title="Minha IA (BYOK)" activeNav="configuracoes">
  <div class="max-w-2xl space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">
        Minha IA (Texto, Busca Web & Capa 16:9)<span class="text-[#D92B2B]">.</span>
      </h1>
      <p class="mt-1.5 text-sm text-black/60">
        Conecte sua própria API para pesquisar tendências ao vivo, redigir no framework e gerar capas 16:9 sem digitar nomes de modelos na mão.
      </p>
    </div>

    <form id="ai-settings-form" class="space-y-6">
      <!-- 1. Text AI -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">1. IA de Redação (Texto)</h2>

        <div>
          <label for="ai_provider" class="block text-xs font-semibold text-black/70">Provedor de IA</label>
          <select
            id="ai_provider"
            name="ai_provider"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          >
            <option value="gemini" selected={current.ai_provider === 'gemini'}>Google Gemini (inclui Busca Google nativa)</option>
            <option value="opencode_go" selected={current.ai_provider === 'opencode_go'}>OpenCode Go (assinatura Go · DeepSeek, GLM, Kimi, etc.)</option>
            <option value="opencode" selected={current.ai_provider === 'opencode'}>OpenCode Zen (modelos grátis e frontier)</option>
            <option value="deepseek" selected={current.ai_provider === 'deepseek'}>DeepSeek (deepseek-chat / deepseek-reasoner)</option>
            <option value="openrouter" selected={current.ai_provider === 'openrouter'}>OpenRouter (Todos os modelos numa única chave)</option>
            <option value="openai" selected={current.ai_provider === 'openai'}>OpenAI (GPT-6.2 / GPT-6.1)</option>
            <option value="anthropic" selected={current.ai_provider === 'anthropic'}>Anthropic Claude (Sonnet 5.5 / Opus 5.5 / Fable 5.2)</option>
            <option value="grok" selected={current.ai_provider === 'grok'}>xAI Grok (Grok 4.7)</option>
            <option value="custom" selected={current.ai_provider === 'custom'}>Endpoint Custom OpenAI-compatible (Hermes / Ollama / LiteLLM)</option>
          </select>
        </div>

        <div id="custom-url-wrap" class={current.ai_provider === 'custom' ? '' : 'hidden'}>
          <label for="ai_base_url" class="block text-xs font-semibold text-black/70">Base URL (OpenAI-compatible)</label>
          <input
            id="ai_base_url"
            name="ai_base_url"
            type="url"
            value={current.ai_base_url}
            placeholder="https://seu-servidor.com/v1"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>

        <div>
          <label for="ai_api_key" class="block text-xs font-semibold text-black/70">Chave de API (API Key)</label>
          <input
            id="ai_api_key"
            name="ai_api_key"
            type="password"
            placeholder={current.has_api_key ? `Salva: ${current.masked_api_key} (deixe vazio para manter)` : 'Cole sua chave AIza... / sk-...'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>

        <div>
          <div class="flex items-center justify-between gap-2">
            <label for="ai_model" class="block text-xs font-semibold text-black/70">Modelo disponível no provedor</label>
            <button
              id="btn-list-models"
              type="button"
              class="text-xs font-semibold text-[#D92B2B] hover:underline cursor-pointer"
            >
              ↻ Atualizar lista da API
            </button>
          </div>
          <select
            id="ai_model"
            name="ai_model"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          ></select>
          <p id="model-list-status" class="mt-1.5 text-[11px] text-black/50"></p>
        </div>
      </section>

      <!-- 2. Live Web Search -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">2. Busca Web ao Vivo</h2>
        <p class="text-xs text-black/60 leading-relaxed">
          Com <strong>Google Gemini</strong>, a busca ao vivo no Google já funciona <strong>nativamente sem precisar de chave extra</strong>.
          Para OpenAI, Claude, Grok ou OpenRouter, você pode adicionar uma chave gratuita do <strong>Tavily</strong> (1.000 buscas/mês grátis) ou colar links de referência direto no editor.
        </p>
        <div>
          <label for="search_api_key" class="block text-xs font-semibold text-black/70">Chave Tavily Search (opcional)</label>
          <input
            id="search_api_key"
            name="search_api_key"
            type="password"
            placeholder={current.has_search_key ? `Salva: ${current.masked_search_key} (deixe vazio para manter)` : 'tvly-... (opcional)'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>
      </section>

      <!-- 3. 16:9 Cover Generator -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">3. Gerador de Capa 16:9 (Google Discover)</h2>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="image_provider" class="block text-xs font-semibold text-black/70">Provedor de Imagem</label>
            <select
              id="image_provider"
              name="image_provider"
              class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm"
            >
              <option value="cloudflare" selected={current.image_provider === 'cloudflare'}>Cloudflare Workers AI (GRÁTIS · sem chave!)</option>
              <option value="huggingface" selected={current.image_provider === 'huggingface'}>Hugging Face (Grátis · FLUX.1 16:9)</option>
              <option value="fal" selected={current.image_provider === 'fal'}>fal.ai (FLUX Schnell / Pro · 16:9)</option>
              <option value="gemini" selected={current.image_provider === 'gemini'}>Google Imagen / Gemini Image</option>
              <option value="openai" selected={current.image_provider === 'openai'}>OpenAI (GPT Image 2.6)</option>
            </select>
          </div>

          <div>
            <label for="image_model" class="block text-xs font-semibold text-black/70">Modelo de Imagem</label>
            <select
              id="image_model"
              name="image_model"
              class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm"
            ></select>
          </div>
        </div>

        <div id="image-key-wrap">
          <label for="image_api_key" class="block text-xs font-semibold text-black/70">
            Chave dedicada para Imagem (opcional — Cloudflare Workers AI não precisa de chave)
          </label>
          <input
            id="image_api_key"
            name="image_api_key"
            type="password"
            placeholder={current.has_image_key ? `Salva: ${current.masked_image_key} (deixe vazio para manter)` : 'Opcional (deixe vazio para Cloudflare grátis ou para reusar a chave acima)'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>
      </section>

      <div id="settings-feedback" class="hidden rounded-2xl px-4 py-3 text-xs font-medium"></div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id="save-settings-btn"
          type="submit"
          class="rounded-full bg-[#1D1D1F] px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 cursor-pointer"
        >
          Salvar tudo
        </button>
        <button
          id="test-ai-btn"
          type="button"
          class="rounded-full border border-black/15 bg-white px-5 py-2.5 text-sm font-semibold text-black/80 hover:bg-black/5 cursor-pointer"
        >
          Testar conexão da IA
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ initialModel: current.ai_model, initialImageModel: current.image_model, maskedProviderKeys }}>
    const providerEl = document.getElementById('ai_provider');
    const modelEl = document.getElementById('ai_model');
    const modelStatusEl = document.getElementById('model-list-status');
    const imgProviderEl = document.getElementById('image_provider');
    const imgModelEl = document.getElementById('image_model');
    const imgKeyWrap = document.getElementById('image-key-wrap');
    const baseUrlWrap = document.getElementById('custom-url-wrap');
    const apiKeyEl = document.getElementById('ai_api_key');
    const fb = document.getElementById('settings-feedback');

    let savedKeysMap = { ...(maskedProviderKeys || {}) };

    const syncKeyPlaceholder = () => {
      const p = providerEl.value;
      if (savedKeysMap[p]) {
        apiKeyEl.placeholder = `Chave salva para ${p}: ${savedKeysMap[p]} (deixe vazio para manter)`;
      } else if (p === 'opencode') {
        apiKeyEl.placeholder = 'Opcional para modelos grátis do OpenCode Zen (ou cole sua chave Zen)';
      } else {
        apiKeyEl.placeholder = `Cole sua API Key de ${p} (suas outras chaves continuam salvas!)`;
      }
    };

    const IMAGE_MODELS = {
      cloudflare: [
        { id: '@cf/black-forest-labs/flux-1-schnell', label: 'FLUX.1 Schnell (Grátis · rápido)' },
        { id: '@cf/stabilityai/stable-diffusion-xl-base-1.0', label: 'SDXL Base 1.0 (Grátis · 16:9 nativo)' },
      ],
      huggingface: [
        { id: 'black-forest-labs/FLUX.1-schnell', label: 'FLUX.1 Schnell (Grátis · 1280×720 16:9)' },
        { id: 'black-forest-labs/FLUX.1-dev', label: 'FLUX.1 Dev (1280×720 16:9)' },
      ],
      fal: [
        { id: 'fal-ai/flux/schnell', label: 'FLUX Schnell (~US$ 0,003 · 16:9)' },
        { id: 'fal-ai/flux-pro/v1.1', label: 'FLUX Pro v1.1 (fotográfico · 16:9)' },
      ],
      gemini: [
        { id: 'gemini-2.5-flash-image', label: 'Gemini Flash Image (nativo)' },
        { id: 'imagen-3.0-generate-002', label: 'Imagen 3 (16:9 · requer faturamento GCP)' },
      ],
      openai: [
        { id: 'gpt-image-2.6-sunburst', label: 'GPT Image 2.6 Sunburst (16:9)' },
        { id: 'gpt-image-2.6-flare', label: 'GPT Image 2.6 Flare (16:9)' },
      ],
    };

    const populateSelect = (selectEl, items, preferred) => {
      const normalized = items.map((it) => (typeof it === 'string' ? { id: it, label: it } : it));
      if (preferred && !normalized.some((x) => x.id === preferred)) {
        normalized.unshift({ id: preferred, label: `${preferred} (atual)` });
      }
      selectEl.innerHTML = normalized
        .map((x) => `<option value="${x.id}" ${x.id === preferred ? 'selected' : ''}>${x.label}</option>`)
        .join('');
    };

    const populateImageModels = (preferred) => {
      const prov = imgProviderEl.value;
      const list = IMAGE_MODELS[prov] || IMAGE_MODELS.cloudflare;
      const validPreferred = preferred && list.some((x) => x.id === preferred) ? preferred : list[0].id;
      populateSelect(imgModelEl, list, validPreferred);
      imgKeyWrap.classList.toggle('hidden', prov === 'cloudflare');
    };

    const getBody = () => ({
      ai_provider: providerEl.value,
      ai_model: modelEl.value,
      ai_base_url: document.getElementById('ai_base_url').value.trim(),
      ai_api_key: apiKeyEl.value.trim(),
      search_api_key: document.getElementById('search_api_key').value.trim(),
      image_provider: imgProviderEl.value,
      image_model: imgModelEl.value,
      image_api_key: document.getElementById('image_api_key').value.trim(),
    });

    const setEmptyModelSelect = (msg) => {
      modelEl.innerHTML = `<option value="">${msg}</option>`;
      modelEl.disabled = true;
    };

    const loadLiveModels = async (silent = false) => {
      const prov = providerEl.value;
      if (!silent) modelStatusEl.textContent = 'Buscando modelos disponíveis direto na API do provedor...';
      try {
        const res = await fetch('/api/admin/models', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(getBody()),
        });
        const data = await res.json();
        if (!res.ok || !data.ok || !Array.isArray(data.models) || data.models.length === 0) {
          throw new Error(data.error || 'Nenhum modelo retornado pela API.');
        }
        modelEl.disabled = false;
        const keep = data.models.includes(modelEl.value)
          ? modelEl.value
          : data.models.includes(initialModel)
            ? initialModel
            : data.models[0];
        populateSelect(modelEl, data.models, keep);
        modelStatusEl.textContent =
          keep !== initialModel
            ? `${data.models.length} modelos ativos carregados. Clique em "Salvar tudo" para gravar ${keep}.`
            : `${data.models.length} modelos ativos carregados direto da sua chave de API.`;
      } catch (err) {
        setEmptyModelSelect('Cole sua API Key e clique em "Atualizar lista da API"');
        modelStatusEl.textContent = err.message || `Cole a API Key de ${prov} para carregar os modelos reais.`;
      }
    };

    const showMsg = (ok, text) => {
      fb.textContent = text;
      fb.className = `rounded-2xl px-4 py-3 text-xs font-medium ${
        ok ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200'
      }`;
    };

    providerEl.addEventListener('change', () => {
      const p = providerEl.value;
      baseUrlWrap.classList.toggle('hidden', p !== 'custom');
      apiKeyEl.value = '';
      syncKeyPlaceholder();
      if (savedKeysMap[p] || p === 'opencode') {
        setEmptyModelSelect('Carregando modelos da API...');
        loadLiveModels(false);
      } else {
        setEmptyModelSelect(`Cole a API Key de ${p} para carregar os modelos`);
        modelStatusEl.textContent = `Cole a API Key de ${p} para carregar os modelos reais disponíveis na sua conta.`;
      }
    });

    apiKeyEl.addEventListener('change', () => {
      if (apiKeyEl.value.trim().length > 10) loadLiveModels(false);
    });

    imgProviderEl.addEventListener('change', () => populateImageModels());
    document.getElementById('btn-list-models').addEventListener('click', () => loadLiveModels(false));

    document.getElementById('ai-settings-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      showMsg(true, 'Salvando configurações...');
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(getBody()),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        if (data.masked_provider_keys) savedKeysMap = data.masked_provider_keys;
        showMsg(true, 'Configurações salvas! Todas as suas chaves por provedor continuam guardadas no cofre.');
        apiKeyEl.value = '';
        syncKeyPlaceholder();
        document.getElementById('search_api_key').value = '';
        document.getElementById('image_api_key').value = '';
      } else {
        showMsg(false, data.error || 'Erro ao salvar.');
      }
    });

    document.getElementById('test-ai-btn').addEventListener('click', async () => {
      const btn = document.getElementById('test-ai-btn');
      btn.disabled = true;
      btn.textContent = 'Testando...';
      showMsg(true, `Testando conexão com ${modelEl.value}...`);
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(getBody()),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          showMsg(true, `Conexão OK com ${modelEl.value}! Resposta: ${data.reply || 'ok'}`);
        } else {
          showMsg(false, `Falha no teste: ${data.error || 'Verifique a chave e o modelo.'}`);
        }
      } catch (err) {
        showMsg(false, `Erro de rede no teste: ${err.message || 'tente novamente'}`);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Testar conexão da IA';
      }
    });

    // Initial hydration (zero hardcoded model fallback)
    syncKeyPlaceholder();
    populateImageModels(initialImageModel);
    if (savedKeysMap[providerEl.value] || providerEl.value === 'opencode') {
      setEmptyModelSelect('Carregando modelos reais da API...');
      loadLiveModels(true);
    } else {
      setEmptyModelSelect('Cole sua API Key para carregar os modelos');
    }
  </script>
</AdminLayout>
