---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getServiceSupabase, isAdminAuthenticated } from '../../lib/admin-auth';

const auth = await isAdminAuthenticated(Astro.request, Astro.cookies, Astro.locals);
if (!auth.ok) {
  return Astro.redirect('/admin/login');
}

const mask = (k?: string | null) =>
  !k ? '' : k.length > 10 ? `${k.slice(0, 6)}••••••${k.slice(-4)}` : '••••••••';

const { client } = getServiceSupabase(Astro.locals);
let current = {
  ai_provider: 'gemini',
  ai_model: 'gemini-3.8-flash',
  ai_base_url: '',
  has_api_key: false,
  masked_api_key: '',
  has_search_key: false,
  masked_search_key: '',
  image_provider: 'auto',
  image_model: 'imagen-3.0-generate-002',
  has_image_key: false,
  masked_image_key: '',
};

if (client) {
  const { data } = await client.from('admin_settings').select('*').eq('id', 'default').maybeSingle();
  if (data) {
    current = {
      ai_provider: data.ai_provider || 'gemini',
      ai_model: data.ai_model || 'gemini-3.8-flash',
      ai_base_url: data.ai_base_url || '',
      has_api_key: Boolean(data.ai_api_key),
      masked_api_key: mask(data.ai_api_key),
      has_search_key: Boolean(data.search_api_key),
      masked_search_key: mask(data.search_api_key),
      image_provider: data.image_provider || 'auto',
      image_model: data.image_model || 'imagen-3.0-generate-002',
      has_image_key: Boolean(data.image_api_key),
      masked_image_key: mask(data.image_api_key),
    };
  }
}
---

<AdminLayout title="Minha IA (BYOK)" activeNav="configuracoes">
  <div class="max-w-2xl space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">
        Minha IA (Texto, Busca Web & Capa 16:9)<span class="text-[#D92B2B]">.</span>
      </h1>
      <p class="mt-1.5 text-sm text-black/60">
        Conecte sua própria API para redigir com busca web ao vivo e gerar capas originais 16:9 direto no editor.
      </p>
    </div>

    <form id="ai-settings-form" class="space-y-6">
      <!-- 1. Text AI -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">1. IA de Redação (Texto)</h2>

        <div>
          <label for="ai_provider" class="block text-xs font-semibold text-black/70">Provedor de IA</label>
          <select
            id="ai_provider"
            name="ai_provider"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          >
            <option value="gemini" selected={current.ai_provider === 'gemini'}>Google Gemini (Gemini 3.8 / 4 + Busca Google nativa)</option>
            <option value="openai" selected={current.ai_provider === 'openai'}>OpenAI (GPT-6.2 / GPT-6.1)</option>
            <option value="anthropic" selected={current.ai_provider === 'anthropic'}>Anthropic Claude (Sonnet 5.5 / Opus 5.5 / Fable 5.2)</option>
            <option value="grok" selected={current.ai_provider === 'grok'}>xAI Grok (Grok 4.7)</option>
            <option value="openrouter" selected={current.ai_provider === 'openrouter'}>OpenRouter (Todos os modelos)</option>
            <option value="custom" selected={current.ai_provider === 'custom'}>Endpoint Custom OpenAI-compatible (Hermes / Ollama / LiteLLM)</option>
          </select>
        </div>

        <div>
          <div class="flex items-center justify-between gap-2">
            <label for="ai_model" class="block text-xs font-semibold text-black/70">Modelo (texto livre ou clique em buscar)</label>
            <button
              id="btn-list-models"
              type="button"
              class="text-xs font-semibold text-[#D92B2B] hover:underline cursor-pointer"
            >
              ↻ Buscar modelos ativos na API
            </button>
          </div>
          <input
            id="ai_model"
            name="ai_model"
            type="text"
            value={current.ai_model}
            placeholder="ex: gemini-3.8-flash, gemini-4-neon, claude-sonnet-5-5, gpt-6.2-sol, grok-4.7"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
          <div id="live-models-wrap" class="mt-2 hidden flex flex-wrap gap-1.5"></div>
        </div>

        <div id="custom-url-wrap" class={current.ai_provider === 'custom' ? '' : 'hidden'}>
          <label for="ai_base_url" class="block text-xs font-semibold text-black/70">Base URL (OpenAI-compatible)</label>
          <input
            id="ai_base_url"
            name="ai_base_url"
            type="url"
            value={current.ai_base_url}
            placeholder="https://seu-servidor.com/v1"
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>

        <div>
          <label for="ai_api_key" class="block text-xs font-semibold text-black/70">Chave de API (API Key)</label>
          <input
            id="ai_api_key"
            name="ai_api_key"
            type="password"
            placeholder={current.has_api_key ? `Salva: ${current.masked_api_key} (deixe vazio para manter)` : 'Cole sua chave AIza... / sk-...'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>
      </section>

      <!-- 2. Live Web Search -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">2. Busca Web ao Vivo</h2>
        <p class="text-xs text-black/60 leading-relaxed">
          Se você usa <strong>Google Gemini</strong>, a busca ao vivo no Google já funciona <strong>nativamente sem precisar de chave extra</strong>.
          Para OpenAI, Claude, Grok ou OpenRouter, você pode adicionar uma chave gratuita do <strong>Tavily</strong> (1.000 buscas/mês grátis) ou colar links de referência direto no editor.
        </p>
        <div>
          <label for="search_api_key" class="block text-xs font-semibold text-black/70">Chave Tavily Search (opcional)</label>
          <input
            id="search_api_key"
            name="search_api_key"
            type="password"
            placeholder={current.has_search_key ? `Salva: ${current.masked_search_key} (deixe vazio para manter)` : 'tvly-... (opcional)'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>
      </section>

      <!-- 3. 16:9 Cover Generator -->
      <section class="rounded-3xl border border-black/10 bg-white p-7 space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-wider text-black/50">3. Gerador de Capa 16:9 (Google Discover)</h2>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="image_provider" class="block text-xs font-semibold text-black/70">Provedor de Imagem</label>
            <select
              id="image_provider"
              name="image_provider"
              class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm"
            >
              <option value="cloudflare" selected={current.image_provider === 'cloudflare'}>Cloudflare Workers AI (GRÁTIS · sem chave!)</option>
              <option value="huggingface" selected={current.image_provider === 'huggingface'}>Hugging Face (Grátis · FLUX.1 16:9 · token hf_...)</option>
              <option value="fal" selected={current.image_provider === 'fal'}>fal.ai (FLUX Schnell / Pro · 16:9 baratinho)</option>
              <option value="gemini" selected={current.image_provider === 'gemini'}>Google Imagen / Gemini Image</option>
              <option value="openai" selected={current.image_provider === 'openai'}>OpenAI (gpt-image-1 / dall-e-3)</option>
              <option value="auto" selected={current.image_provider === 'auto'}>Automático (usa o mesmo da redação)</option>
            </select>
          </div>

          <div>
            <label for="image_model" class="block text-xs font-semibold text-black/70">Modelo de Imagem</label>
            <input
              id="image_model"
              name="image_model"
              type="text"
              value={current.image_model}
              placeholder="imagen-3.0-generate-002 ou gpt-image-1"
              class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-3.5 py-2.5 text-sm"
            />
          </div>
        </div>

        <div>
          <label for="image_api_key" class="block text-xs font-semibold text-black/70">
            Chave dedicada para Imagem (opcional — deixe vazio para reusar a chave de cima)
          </label>
          <input
            id="image_api_key"
            name="image_api_key"
            type="password"
            placeholder={current.has_image_key ? `Salva: ${current.masked_image_key} (deixe vazio para manter)` : 'Opcional (se quiser usar Gemini para imagem e Claude para texto)'}
            class="mt-1.5 w-full rounded-xl border border-black/15 bg-[#F5F5F7] px-4 py-2.5 text-sm focus:border-black focus:bg-white focus:outline-none"
          />
        </div>
      </section>

      <div id="settings-feedback" class="hidden rounded-2xl px-4 py-3 text-xs font-medium"></div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id="save-settings-btn"
          type="submit"
          class="rounded-full bg-[#1D1D1F] px-6 py-2.5 text-sm font-semibold text-white hover:opacity-90 cursor-pointer"
        >
          Salvar tudo
        </button>
        <button
          id="test-ai-btn"
          type="button"
          class="rounded-full border border-black/15 bg-white px-5 py-2.5 text-sm font-semibold text-black/80 hover:bg-black/5 cursor-pointer"
        >
          Testar conexão da IA
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    const providerEl = document.getElementById('ai_provider');
    const modelEl = document.getElementById('ai_model');
    const imgProviderEl = document.getElementById('image_provider');
    const imgModelEl = document.getElementById('image_model');
    const baseUrlWrap = document.getElementById('custom-url-wrap');
    const fb = document.getElementById('settings-feedback');

    const defaultModels = {
      gemini: 'gemini-3.8-flash',
      openai: 'gpt-6.2-sol',
      anthropic: 'claude-sonnet-5-5',
      grok: 'grok-4.7',
      openrouter: 'google/gemini-3.8-flash',
      custom: 'gemini-3.8-flash',
    };

    providerEl?.addEventListener('change', () => {
      const p = providerEl.value;
      baseUrlWrap.classList.toggle('hidden', p !== 'custom');
      if (defaultModels[p]) modelEl.value = defaultModels[p];
    });

    imgProviderEl?.addEventListener('change', () => {
      const map = {
        cloudflare: '@cf/black-forest-labs/flux-1-schnell',
        huggingface: 'black-forest-labs/FLUX.1-schnell',
        fal: 'fal-ai/flux/schnell',
        gemini: 'gemini-2.5-flash-image',
        openai: 'gpt-image-2.6-sunburst',
      };
      if (map[imgProviderEl.value]) imgModelEl.value = map[imgProviderEl.value];
    });

    document.getElementById('btn-list-models')?.addEventListener('click', async () => {
      const wrap = document.getElementById('live-models-wrap');
      showMsg(true, 'Consultando modelos ativos na sua chave de API...');
      const res = await fetch('/api/admin/models', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(getBody()),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        showMsg(false, data.error || 'Não foi possível listar modelos.');
        return;
      }
      wrap.innerHTML = (data.models || [])
        .map(
          (id) =>
            `<button type="button" data-pick-model="${id}" class="rounded-full border border-black/15 bg-[#F5F5F7] px-2.5 py-1 text-[11px] font-mono hover:bg-black hover:text-white transition-colors cursor-pointer">${id}</button>`
        )
        .join('');
      wrap.classList.remove('hidden');
      wrap.querySelectorAll('[data-pick-model]').forEach((b) => {
        b.addEventListener('click', () => {
          modelEl.value = b.dataset.pickModel;
        });
      });
      showMsg(true, `${data.models.length} modelos ativos carregados! Clique em um chip para selecionar.`);
    });

    const showMsg = (ok, text) => {
      fb.textContent = text;
      fb.className = `rounded-2xl px-4 py-3 text-xs font-medium ${
        ok ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200'
      }`;
    };

    const getBody = () => ({
      ai_provider: providerEl.value,
      ai_model: modelEl.value.trim(),
      ai_base_url: document.getElementById('ai_base_url').value.trim(),
      ai_api_key: document.getElementById('ai_api_key').value.trim(),
      search_api_key: document.getElementById('search_api_key').value.trim(),
      image_provider: imgProviderEl.value,
      image_model: imgModelEl.value.trim(),
      image_api_key: document.getElementById('image_api_key').value.trim(),
    });

    document.getElementById('ai-settings-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      showMsg(true, 'Salvando configurações...');
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(getBody()),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        showMsg(true, 'Configurações salvas! Busca web ao vivo e gerador de capa 16:9 prontos no Editor.');
        document.getElementById('ai_api_key').value = '';
        document.getElementById('search_api_key').value = '';
        document.getElementById('image_api_key').value = '';
      } else {
        showMsg(false, data.error || 'Erro ao salvar.');
      }
    });

    document.getElementById('test-ai-btn')?.addEventListener('click', async () => {
      showMsg(true, 'Testando conexão com a API...');
      const res = await fetch('/api/admin/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(getBody()),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        showMsg(true, `Conexão OK! Resposta: ${data.reply || 'ok'}`);
      } else {
        showMsg(false, `Falha no teste: ${data.error || 'Verifique a chave e o modelo.'}`);
      }
    });
  </script>
</AdminLayout>
