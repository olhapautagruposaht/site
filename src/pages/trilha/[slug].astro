---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TRILHAS } from '../../data/pautas';
import { fetchPublishedPautas } from '../../lib/supabase';

const { slug } = Astro.params;
const trilha = TRILHAS.find((t) => t.slug === slug);

if (!trilha) {
  return Astro.redirect('/404', 404);
}

const allPautas = await fetchPublishedPautas();
const pautas = allPautas.filter((p) => p.trilha === trilha.slug);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=600'
);

const formatFullDate = (iso: string) =>
  new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(iso));

const pageUrl = `https://olhapauta.com.br/trilha/${trilha.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `${trilha.nome} | OlhaPauta`,
      description: trilha.descricao,
      url: pageUrl,
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Início',
          item: 'https://olhapauta.com.br/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: trilha.nome,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${trilha.nome} | OlhaPauta`}
  description={trilha.descricao}
  canonicalPath={`/trilha/${trilha.slug}`}
  jsonLd={jsonLd}
>
  <div class="bg-[var(--color-surface)] dark:bg-[#0D0E11] transition-colors duration-200">
    <section class="mx-auto max-w-[980px] px-5 pt-10 pb-16 sm:pt-14 sm:pb-20">
      <div class="mb-9">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-ink-subtle)] dark:text-[var(--color-dark-subtle)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors mb-3"
        >
          <span>←</span>
          <span>Voltar para a capa</span>
        </a>
        <h1 class="text-[32px] sm:text-[40px] font-bold tracking-[-0.03em] text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
          {trilha.nome}<span class="text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">.</span>
        </h1>
        <p class="mt-2.5 max-w-2xl text-[16px] sm:text-[18px] leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
          {trilha.descricao}
        </p>
      </div>

      <!-- Trail Switcher -->
      <div class="flex flex-wrap gap-1.5 mb-8">
        {TRILHAS.map((t) => {
          const isCurrent = t.slug === trilha.slug;
          return (
            <a
              href={`/trilha/${t.slug}`}
              data-astro-prefetch="viewport"
              class={`rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors ${
                isCurrent
                  ? 'bg-[var(--color-ink)] text-[var(--color-paper)] dark:bg-[var(--color-dark-ink)] dark:text-[var(--color-dark-paper)]'
                  : 'bg-[var(--color-paper)] dark:bg-[var(--color-dark-surface)] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)]'
              }`}
            >
              {t.nome}
            </a>
          );
        })}
      </div>

      {pautas.length > 0 ? (
        <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {pautas.map((pauta) => (
            <article class="group flex flex-col overflow-hidden rounded-[20px] bg-[var(--color-paper)] dark:bg-[var(--color-dark-surface)] transition-shadow duration-300 hover:shadow-[0_12px_36px_rgba(0,0,0,0.06)] dark:hover:shadow-[0_12px_36px_rgba(0,0,0,0.35)]">
              <a
                href={`/pauta/${pauta.slug}`}
                data-astro-prefetch="viewport"
                class="flex flex-1 flex-col focus:outline-none"
              >
                <div class="overflow-hidden bg-[var(--color-rule)] dark:bg-[var(--color-dark-rule)]">
                  <img
                    src={pauta.imagem.url}
                    alt={pauta.imagem.alt}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                  />
                </div>

                <div class="flex flex-1 flex-col justify-between p-6">
                  <div>
                    <span class="text-[11px] font-semibold uppercase tracking-[0.04em] text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">
                      {pauta.trilhaLabel}
                    </span>

                    <h2 class="mt-2 text-[18px] font-bold leading-[1.25] tracking-[-0.018em] text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
                      {pauta.titulo}
                    </h2>
                  </div>

                  <div class="mt-5 flex items-center justify-between text-[12px] font-medium text-[var(--color-ink-subtle)] dark:text-[var(--color-dark-subtle)]">
                    <time datetime={pauta.dataISO}>{formatFullDate(pauta.dataISO)}</time>
                    <span>{pauta.tempoLeitura.toLowerCase()}</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-[20px] bg-[var(--color-paper)] dark:bg-[var(--color-dark-surface)] p-10 text-center">
          <p class="text-[15px] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
            Em breve novas pautas publicadas na trilha de {trilha.nome}.
          </p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
