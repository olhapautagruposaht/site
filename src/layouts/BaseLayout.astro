---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { PAUTAS, TRILHAS } from '../data/pautas';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  jsonLd?: Record<string, unknown>;
  showReadingBar?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=1600&q=85',
  ogType = 'website',
  canonicalPath = '/',
  publishedTime,
  modifiedTime,
  articleSection,
  jsonLd,
  showReadingBar = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://olhapauta.com.br').toString();
const logoLightUrl = '/images/logo-olhapauta.webp';
const logoDarkUrl = '/images/logo-olhapauta-dark.webp';
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const searchIndex = PAUTAS.map((p) => ({
  titulo: p.titulo,
  trilha: p.trilhaLabel,
  slug: p.slug,
  data: p.dataPublicacao,
}));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="OlhaPauta RSS" href="/rss.xml" />

    <!-- Open Graph / Google Discover -->
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="OlhaPauta" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Typography: Single-Family Apple-like Clarity (Inter / SF Pro) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Anti-flicker theme initialization (default: crisp Apple Light) -->
    <script is:inline>
      (() => {
        const applyTheme = () => {
          const stored = localStorage.getItem('op-theme');
          document.documentElement.classList.toggle('dark', stored === 'dark');
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <ClientRouter />

    {adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body class="min-h-screen bg-[var(--color-paper)] text-[var(--color-ink)] dark:bg-[var(--color-dark-paper)] dark:text-[var(--color-dark-ink)] transition-colors duration-200">
    <!-- Accessibility: Skip to main content -->
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-xs focus:font-medium focus:text-[var(--color-paper)] focus:outline-none"
    >
      Pular para o conteúdo
    </a>

    <!-- Signature OlhaPauta Red Dot Page Transition Indicator -->
    <div
      id="op-nav-indicator"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-[70] opacity-0 transition-opacity duration-200"
    >
      <div class="h-[2px] w-full overflow-hidden bg-transparent">
        <div class="op-dot-bar h-full w-1/3 bg-[var(--color-accent)] dark:bg-[var(--color-dark-accent)]"></div>
      </div>
      <div class="fixed bottom-6 right-6 flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-paper)]/90 dark:bg-[var(--color-dark-surface)]/90 border border-[var(--color-rule)] dark:border-[var(--color-dark-rule)] shadow-lg backdrop-blur-md">
        <span class="op-dot-loading h-2.5 w-2.5 rounded-full bg-[var(--color-accent)] dark:bg-[var(--color-dark-accent)]"></span>
      </div>
    </div>

    {showReadingBar && (
      <div
        id="reading-progress"
        class="fixed top-0 left-0 z-50 h-[2px] w-0 bg-[var(--color-accent)] dark:bg-[var(--color-dark-accent)] transition-[width] duration-75"
        aria-hidden="true"
      />
    )}

    <!-- Apple Newsroom Style Header -->
    <header transition:name="site-header" class="sticky top-0 z-40 bg-[var(--color-paper)]/88 dark:bg-[var(--color-dark-paper)]/88 backdrop-blur-xl">
      <div class="mx-auto flex h-13 max-w-[980px] items-center justify-between gap-6 px-5">
        <!-- Left: Brand Logo Only -->
        <a href="/" class="flex items-center focus:outline-none hover:opacity-75 transition-opacity" aria-label="OlhaPauta: Início">
          <img
            src={logoLightUrl}
            alt="OlhaPauta"
            class="block dark:hidden h-[20px] w-auto object-contain object-left"
            width="128"
            height="20"
          />
          <img
            src={logoDarkUrl}
            alt="OlhaPauta"
            class="hidden dark:block h-[20px] w-auto object-contain object-left"
            width="128"
            height="20"
          />
        </a>

        <!-- Right: Subtle links + Soft Search Pill + Minimal Theme Toggle -->
        <div class="flex items-center gap-5 sm:gap-6">
          <nav class="hidden md:flex items-center gap-6" aria-label="Trilhas de conteúdo">
            {TRILHAS.map((trilha) => (
              <a
                href={`/trilha/${trilha.slug}`}
                data-astro-prefetch="viewport"
                class="text-[12px] font-normal text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors"
              >
                {trilha.nome}
              </a>
            ))}
          </nav>

          <button
            id="open-search"
            type="button"
            aria-label="Buscar no OlhaPauta"
            class="inline-flex h-8 w-8 items-center justify-center rounded-full text-[var(--color-ink-subtle)] dark:text-[var(--color-dark-subtle)] hover:bg-[var(--color-surface)] dark:hover:bg-[var(--color-dark-surface)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors cursor-pointer"
          >
            <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </button>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Alternar modo claro e escuro"
            class="inline-flex h-7 w-7 items-center justify-center rounded-full text-[var(--color-ink-subtle)] dark:text-[var(--color-dark-subtle)] hover:bg-[var(--color-surface)] dark:hover:bg-[var(--color-dark-surface)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors cursor-pointer"
          >
            <svg class="hidden dark:block h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="block dark:hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Search Modal (Clean Apple Spotlight style) -->
    <div
      id="search-modal"
      class="fixed inset-0 z-50 hidden items-start justify-center bg-black/30 backdrop-blur-sm px-4 pt-20"
      aria-modal="true"
      role="dialog"
    >
      <div class="w-full max-w-xl overflow-hidden rounded-2xl bg-[var(--color-paper)] dark:bg-[var(--color-dark-surface)] shadow-2xl border border-[var(--color-rule)] dark:border-[var(--color-dark-rule)]">
        <div class="flex items-center gap-3 border-b border-[var(--color-rule)] dark:border-[var(--color-dark-rule)] px-4 py-3.5">
          <svg class="h-4 w-4 text-[var(--color-ink-subtle)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Buscar pautas de Inteligência Artificial..."
            class="w-full bg-transparent text-sm text-[var(--color-ink)] dark:text-[var(--color-dark-ink)] placeholder:text-[var(--color-ink-subtle)] focus:outline-none"
          />
          <button id="close-search" type="button" class="text-xs text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] cursor-pointer">
            ESC
          </button>
        </div>
        <div id="search-results" class="max-h-80 overflow-y-auto divide-y divide-[var(--color-rule)] dark:divide-[var(--color-dark-rule)] p-2"></div>
      </div>
    </div>

    <main id="conteudo-principal" tabindex="-1" transition:name="pauta-content" class="focus:outline-none">
      <slot />
    </main>

    <!-- Clean Editorial Footer -->
    <footer class="mt-20 border-t border-[var(--color-rule)] dark:border-[var(--color-dark-rule)] bg-[var(--color-surface)] dark:bg-[var(--color-dark-surface)]">
      <div class="mx-auto max-w-[980px] px-5 py-12 sm:py-14">
        <div class="grid gap-10 md:grid-cols-12">
          <div class="md:col-span-6">
            <a href="/" class="inline-block focus:outline-none hover:opacity-75 transition-opacity" aria-label="OlhaPauta">
              <img
                src={logoLightUrl}
                alt="OlhaPauta"
                class="block dark:hidden h-[19px] w-auto object-contain object-left"
                width="122"
                height="19"
              />
              <img
                src={logoDarkUrl}
                alt="OlhaPauta"
                class="hidden dark:block h-[19px] w-auto object-contain object-left"
                width="122"
                height="19"
              />
            </a>
            <p class="mt-3.5 max-w-sm text-[13px] leading-relaxed text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
              Publicação independente dedicada a Inteligência Artificial. Análises claras, guias práticos e leitura organizada, sem ruído.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-8 md:col-span-6">
            <div>
              <p class="text-[12px] font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
                Trilhas
              </p>
              <ul class="mt-3 space-y-2 text-[13px]">
                {TRILHAS.map((trilha) => (
                  <li>
                    <a
                      href={`/trilha/${trilha.slug}`}
                      data-astro-prefetch="viewport"
                      class="text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)] hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors"
                    >
                      {trilha.nome}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <p class="text-[12px] font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
                Institucional
              </p>
              <ul class="mt-3 space-y-2 text-[13px] text-[var(--color-ink-muted)] dark:text-[var(--color-dark-muted)]">
                <li><a href="/sobre" class="hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors">Sobre</a></li>
                <li><a href="/politica-editorial" class="hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors">Política Editorial</a></li>
                <li><a href="/politica-de-privacidade" class="hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors">Privacidade</a></li>
                <li><a href="/contato" class="hover:text-[var(--color-ink)] dark:hover:text-[var(--color-dark-ink)] transition-colors">Contato</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 flex items-center justify-between gap-4 border-t border-[var(--color-rule)] dark:border-[var(--color-dark-rule)] pt-5 text-[12px] text-[var(--color-ink-subtle)] dark:text-[var(--color-dark-subtle)]">
          <span>© 2026 OlhaPauta<span class="text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">.</span></span>
          <span>olhapauta.com.br</span>
        </div>
      </div>
    </footer>

    <CookieBanner />

    <script is:inline define:vars={{ searchIndex }}>
      (() => {
        let hideTimer = null;

        const showNavIndicator = () => {
          const el = document.getElementById('op-nav-indicator');
          if (!el) return;
          clearTimeout(hideTimer);
          el.classList.remove('opacity-0');
          el.classList.add('opacity-100');
        };

        const hideNavIndicator = () => {
          const el = document.getElementById('op-nav-indicator');
          if (!el) return;
          clearTimeout(hideTimer);
          hideTimer = setTimeout(() => {
            el.classList.remove('opacity-100');
            el.classList.add('opacity-0');
          }, 220);
        };

        document.addEventListener('astro:before-preparation', showNavIndicator);
        document.addEventListener('astro:page-load', hideNavIndicator);
      })();

      document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById('theme-toggle');
        if (toggleBtn && !toggleBtn.dataset.bound) {
          toggleBtn.dataset.bound = '1';
          toggleBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('op-theme', isDark ? 'dark' : 'light');
          });
        }

        const modal = document.getElementById('search-modal');
        const openBtn = document.getElementById('open-search');
        const closeBtn = document.getElementById('close-search');
        const input = document.getElementById('search-input');
        const resultsEl = document.getElementById('search-results');

        if (!modal || modal.dataset.bound) return;
        modal.dataset.bound = '1';

        const renderResults = (query = '') => {
          if (!resultsEl) return;
          const q = query.trim().toLowerCase();
          const filtered = q
            ? searchIndex.filter((item) => item.titulo.toLowerCase().includes(q) || item.trilha.toLowerCase().includes(q))
            : searchIndex;

          if (filtered.length === 0) {
            resultsEl.innerHTML = '<p class="p-4 text-sm text-[var(--color-ink-subtle)]">Nenhuma pauta encontrada.</p>';
            return;
          }

          resultsEl.innerHTML = filtered
            .map(
              (item) => `
              <a href="/pauta/${item.slug}" class="block rounded-lg px-3 py-3 hover:bg-[var(--color-surface)] dark:hover:bg-[var(--color-dark-paper)] transition-colors">
                <p class="text-[11px] font-medium text-[var(--color-ink-subtle)]">${item.trilha} · ${item.data}</p>
                <p class="mt-0.5 text-sm font-medium text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">${item.titulo}</p>
              </a>`
            )
            .join('');
        };

        const openModal = () => {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          renderResults();
          setTimeout(() => input?.focus(), 20);
        };

        const closeModal = () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          if (input) input.value = '';
        };

        openBtn?.addEventListener('click', openModal);
        closeBtn?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });
        input?.addEventListener('input', (e) => renderResults(e.target.value));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      });
    </script>
  </body>
</html>
